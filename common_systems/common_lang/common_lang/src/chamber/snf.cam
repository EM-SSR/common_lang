# ---- 走査の初期値 ----
i0        ke  0 0
i1        ke  128 0
.         ti  i0 i1                      # p ← CASE
i2        ke  4 0
i3        ke  0 0
.         ti  i2 i3                      # o ← 0

# ================ 外側: CASE の語を一つずつ ================
#
# 反復は Ω 閉包で書く（10 章 §2 末、仕様 §18）。境界は work[p] ≠ −1 で、
# 終端標識に届いたら後退分離が止まる。
# 語が一つも無い場合は前方分離で分ける（§16 の path separation）。
cg0       ke  0 0
cgp       ta  cg0
cgn       ta  cgp
cgm       ke  -1 0
.         se  cgm cgn Lcase
.         so  Lcmp0
Lcase     ke  0 0
pv        ta  Lcase                      # p
nn        ta  pv                         # work[p] = n
one1      ke  1 0
pv1       ko  pv one1
.         ti  Lcase pv1                  # p ← p+1
w3        ke  3 0
.         ti  w3 nn                      # n ← 文字数
w1        ke  1 0
zz        ke  0 0
.         ti  w1 zz                      # L ← 0
w2        ke  2 0
.         ti  w2 zz                      # E ← 0

# ---- 内側: n 文字を読む。境界は 0 < n ----
rg0       ke  3 0
rgn       ta  rg0
rgz       ke  0 0
.         se  rgz rgn Lread
.         so  Lemit
Lread     ke  3 0
nv        ta  Lread
r0        ke  0 0
pw        ta  r0
cc        ta  pw                         # 文字 c
r1        ke  1 0
pw2       ko  pw r1
.         ti  r0 pw2                     # p ← p+1
rm        ke  -1 0
nv2       ko  nv rm
.         ti  Lread nv2                  # n ← n-1
r2        ke  1 0
lv        ta  r2                         # L
z2        ke  0 0
.         su  lv z2 Lpush                # 空なら押す
cB        ke  32 0
rm2       ke  -1 0
lm        ko  lv rm2
ad        ko  cB lm
tp        ta  ad                         # BUF[L-1]
.         su  tp cc Lpop                 # 同じ文字なら消す

# ---- 押す ----
Lpush     ke  32 0
ba        ko  Lpush lv
.         ti  ba cc                      # BUF[L] ← c
p1        ke  1 0
lv2       ko  lv p1
p2        ke  1 0
.         ti  p2 lv2                     # L ← L+1
.         so  Rcnt

# ---- 消す。ii ⇒ σ、jj ⇒ e ----
Lpop      ke  1 0
q1        ke  -1 0
lv3       ko  lv q1
.         ti  Lpop lv3                   # L ← L-1
q2        ke  1 0
.         su  cc q2 Lflip                # c = i のときだけ符号が動く
.         so  Rcnt

# ---- 符号の反転。ε ∈ {0,1} なので 2 に達したら 0 へ戻す ----
Lflip     ke  2 0
ev        ta  Lflip
q3        ke  1 0
ne        ko  ev q3
q4        ke  2 0
.         su  ne q4 Lzero
.         ti  Lflip ne
.         so  Rcnt
Lzero     ke  2 0
z3        ke  0 0
.         ti  Lzero z3
.         so  Rcnt

# ---- 内側の閉じ ----
Rcnt      ke  3 0
rcn       ta  Rcnt
rcz       ke  0 0
.         se  rcz rcn Lread

# ---- 一語分の正規形を OUT へ書く ----
Lemit     ke  4 0
ov        ta  Lemit                      # o
cOU       ke  64 0
oa        ko  cOU ov
e2        ke  2 0
ev2       ta  e2
.         ti  oa ev2                     # OUT[o] ← ε
s1        ke  1 0
ov1       ko  ov s1
oa1       ko  cOU ov1
s2        ke  1 0
lv4       ta  s2
.         ti  oa1 lv4                    # OUT[o+1] ← m
s3        ke  1 0
ov2       ko  ov1 s3
.         ti  Lemit ov2                  # o ← o+2
s4        ke  5 0
z4        ke  0 0
.         ti  s4 z4                      # k ← 0

# ---- 内側: BUF を OUT へ写す。境界は k < m ----
mg0       ke  5 0
mgk       ta  mg0
mg1       ke  1 0
mgm       ta  mg1
.         se  mgk mgm Lmove
.         so  Ccl
Lmove     ke  5 0
kv        ta  Lmove
u2        ke  32 0
sa2       ko  u2 kv
vv        ta  sa2                        # BUF[k]
u3        ke  4 0
ov3       ta  u3
u4        ke  64 0
da        ko  u4 ov3
.         ti  da vv                      # OUT[o] ← BUF[k]
u5        ke  1 0
ov4       ko  ov3 u5
.         ti  u3 ov4                     # o ← o+1
kv2       ko  kv u5
.         ti  Lmove kv2                  # k ← k+1
mc0       ke  5 0
mck       ta  mc0
mc1       ke  1 0
mcm       ta  mc1
.         se  mck mcm Lmove

# ---- 外側の閉じ ----
Ccl       ke  0 0
ccp       ta  Ccl
ccn       ta  ccp
ccm       ke  -1 0
.         se  ccm ccn Lcase

# ================ 突き合わせ（13 章 §5）================
Lcmp0     ke  4 0
ovf       ta  Lcmp0
c57       ke  57 0
.         su  ovf c57 Lclr               # 出力語数が合わなければ失敗
.         so  Lko
Lclr      ke  5 0
z5        ke  0 0
.         ti  Lclr z5                    # k ← 0

# ---- 突き合わせの走査。境界は k < 57 ----
kg0       ke  5 0
kgk       ta  kg0
kg1       ke  57 0
.         se  kgk kg1 Lcmp
.         so  Lok
Lcmp      ke  5 0
kv3       ta  Lcmp
v2        ke  64 0
aa        ko  v2 kv3
av        ta  aa
v3        ke  256 0
bb        ko  v3 kv3
bv        ta  bb
.         su  av bv Lnext
.         so  Lko
Lnext     ke  1 0
kv4       ko  kv3 Lnext
v4        ke  5 0
.         ti  v4 kv4
kc0       ke  5 0
kck       ta  kc0
kc1       ke  57 0
.         se  kck kc1 Lcmp

Lok       tu
Lko       te
