# ======== 集積点への収束（§5.1、§8.1）========
# 時間位置は t_{n+1} = beta_a(t_n) で作る。閉形は
#     t_n = a + 2^{-n}(t_0 - a)
# になり、n を上げると a へ集積する。極限を追わずに済むのは、
#     x = beta_a(x)   <=>   2x = x + a   <=>   x = a
# と一段で解けるからになる。これが Omega_a[beta_a; x_0] = a の中身になる。
# ここでは分子だけを扱う。深さ n では t_n - a の分子が t_0 - a の分子に等しい。
v00001    ke  0 0
v00002    ke  0 0
.         ti  v00002 v00001
# ---- 入口。0 回のときは本体へ入らない（§16 の前方分離）----
ENTW1     ke  0 0
LcaW1     ke  0 0
v00003W1  ke  0 0
v00004W1  ta  v00003W1
v00005W1  ke  9 0
.         se  v00004W1 v00005W1 Lca
.         so  Lcae
Lca       ke  0 0
v00003    ke  0 0
v00004    ta  v00003
v00005    ke  9 0
#   a の座標と、初期点 t_0 = p_{++} を取る
v00006    ke  32 0
v00007    ke  2 0
v00008    sa  v00004 v00007
v00009    ko  v00006 v00008
v00010    ta  v00009
