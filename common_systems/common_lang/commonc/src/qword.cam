# ================= 構成語の接合（Quantale.mulWord）=================
#
#   引数  語 700-702 = (m1, e1, s1)、語 703-705 = (m2, e2, s2)
#   返り  語 706-708 = (m, e, s)、戻り符号は語 709
#
# 継ぎ目で末尾と先頭が一致すると、交替語なので短い方が尽きるまで畳む。
# 畳んだ i の対だけが符号を反転する

WMUL      ke  0 0
WM1m      ke  700 0
WM1mv     ta  WM1m
WM1e      ke  701 0
WM1ev     ta  WM1e
WM1z      ke  0 0
.         se  WM1z WM1mv WM1PJ
.         se  WM1mv WM1z WM1PI
WM1ZF     ke  0 0
WM1zf     ke  761 0
.         ti  WM1zf WM1ZF
WM1zl     ke  760 0
.         ti  WM1zl WM1ev
.         so  WM1EN

WM1PJ     ke  1 0
WM1jf     ke  761 0
.         ti  WM1jf WM1PJ
WM1j2     ke  2 0
WM1j2m    sa  WM1j2 WM1mv
WM1jne    si  WM1ev
WM1jL     ko  WM1j2m WM1jne
WM1jl     ke  760 0
.         ti  WM1jl WM1jL
.         so  WM1EN

WM1PI     ke  0 0
WM1if     ke  761 0
.         ti  WM1if WM1PI
WM1i2     ke  2 0
WM1i2m    sa  WM1i2 WM1mv
WM1ing    si  WM1i2m
WM1iL     ko  WM1ing WM1ev
WM1il     ke  760 0
.         ti  WM1il WM1iL
.         so  WM1EN

WM1EN     ke  0 0

WM2m      ke  703 0
WM2mv     ta  WM2m
WM2e      ke  704 0
WM2ev     ta  WM2e
WM2z      ke  0 0
.         se  WM2z WM2mv WM2PJ
.         se  WM2mv WM2z WM2PI
WM2ZF     ke  0 0
WM2zf     ke  763 0
.         ti  WM2zf WM2ZF
WM2zl     ke  762 0
.         ti  WM2zl WM2ev
.         so  WM2EN

WM2PJ     ke  1 0
WM2jf     ke  763 0
.         ti  WM2jf WM2PJ
WM2j2     ke  2 0
WM2j2m    sa  WM2j2 WM2mv
WM2jne    si  WM2ev
WM2jL     ko  WM2j2m WM2jne
WM2jl     ke  762 0
.         ti  WM2jl WM2jL
.         so  WM2EN

WM2PI     ke  0 0
WM2if     ke  763 0
.         ti  WM2if WM2PI
WM2i2     ke  2 0
WM2i2m    sa  WM2i2 WM2mv
WM2ing    si  WM2i2m
WM2iL     ko  WM2ing WM2ev
WM2il     ke  762 0
.         ti  WM2il WM2iL
.         so  WM2EN

WM2EN     ke  0 0

# 符号は先に掛けておく
WMs1      ke  702 0
WMs1v     ta  WMs1
WMs2      ke  705 0
WMs2v     ta  WMs2
WMss      sa  WMs1v WMs2v
WMsst     ke  764 0
.         ti  WMsst WMss

# どちらかが空語なら、相手をそのまま返す
WMl1      ke  760 0
WMl1v     ta  WMl1
WMz1      ke  0 0
.         su  WMl1v WMz1 WMR2
WMl2      ke  762 0
WMl2v     ta  WMl2
WMz2      ke  0 0
.         su  WMl2v WMz2 WMR1
.         so  WMGO

WMR2      ke  706 0
WMR2m     ke  703 0
WMR2mv    ta  WMR2m
.         ti  WMR2 WMR2mv
WMR2e     ke  707 0
WMR2ev0   ke  704 0
WMR2ev    ta  WMR2ev0
.         ti  WMR2e WMR2ev
.         so  WMRS

WMR1      ke  706 0
WMR1m     ke  700 0
WMR1mv    ta  WMR1m
.         ti  WMR1 WMR1mv
WMR1e     ke  707 0
WMR1ev0   ke  701 0
WMR1ev    ta  WMR1ev0
.         ti  WMR1e WMR1ev
.         so  WMRS

# 末尾は長さの偶奇で決まる。奇数なら先頭と同じ、偶数なら反対になる
WMGO      ke  760 0
WMGOl     ta  WMGO
WMhtq0    ke  0 0
WMhtsq    ke  772 0
.         ti  WMhtsq WMhtq0
WMhtr0    ke  760 0
WMhtr0v   ta  WMhtr0
WMhtsr    ke  773 0
.         ti  WMhtsr WMhtr0v

WMhtLP    ke  773 0
WMhtLPv   ta  WMhtLP
WMhtt2    ke  2 0
.         se  WMhtLPv WMhtt2 WMhtDN
WMhtnt2   si  WMhtt2
WMhtsub   ko  WMhtLPv WMhtnt2
WMhtss    ke  773 0
.         ti  WMhtss WMhtsub
WMhtqq    ke  772 0
WMhtqqv   ta  WMhtqq
WMhto1    ke  1 0
WMhtq2    ko  WMhtqqv WMhto1
WMhtsq2   ke  772 0
.         ti  WMhtsq2 WMhtq2
.         so  WMhtLP

WMhtDN    ke  0 0

WMpar     ke  773 0
WMparv    ta  WMpar
WMf1      ke  761 0
WMf1v     ta  WMf1
WMo1      ke  1 0
.         su  WMparv WMo1 WMTF
WMnf      ko  WMo1 WMf1v
WMnf2     si  WMf1v
WMnf3     ko  WMo1 WMnf2
WMst1     ke  765 0
.         ti  WMst1 WMnf3
.         so  WMTK
WMTF      ke  765 0
.         ti  WMTF WMf1v
.         so  WMTK

# 継ぎ目が合わなければ畳まない
WMTK      ke  765 0
WMt1      ta  WMTK
WMf2      ke  763 0
WMf2v     ta  WMf2
.         su  WMt1 WMf2v WMFOLD
WMk0      ke  766 0
WMk0z     ke  0 0
.         ti  WMk0 WMk0z
.         so  WMLEN

# 合えば短い方が尽きるまで畳む
WMFOLD    ke  760 0
WMFl1     ta  WMFOLD
WMFL2     ke  762 0
WMFl2     ta  WMFL2
.         se  WMFl1 WMFl2 WMFA
WMFk2     ke  766 0
.         ti  WMFk2 WMFl2
.         so  WMLEN
WMFA      ke  766 0
.         ti  WMFA WMFl1
.         so  WMLEN

# 長さ L = L1 + L2 − 2k
WMLEN     ke  760 0
WMLl1     ta  WMLEN
WMLL2     ke  762 0
WMLl2     ta  WMLL2
WMLK      ke  766 0
WMLk      ta  WMLK
WMLt2     ke  2 0
WMLk2     sa  WMLt2 WMLk
WMLnk     si  WMLk2
WMLs      ko  WMLl1 WMLl2
WMLv      ko  WMLs WMLnk
WMLst     ke  767 0
.         ti  WMLst WMLv

# 畳んだ i の対の数だけ符号が反転する。末尾が i なら ceil(k/2)、j なら floor(k/2)
WMhkq0    ke  0 0
WMhksq    ke  774 0
.         ti  WMhksq WMhkq0
WMhkr0    ke  766 0
WMhkr0v   ta  WMhkr0
WMhksr    ke  775 0
.         ti  WMhksr WMhkr0v

WMhkLP    ke  775 0
WMhkLPv   ta  WMhkLP
WMhkt2    ke  2 0
.         se  WMhkLPv WMhkt2 WMhkDN
WMhknt2   si  WMhkt2
WMhksub   ko  WMhkLPv WMhknt2
WMhkss    ke  775 0
.         ti  WMhkss WMhksub
WMhkqq    ke  774 0
WMhkqqv   ta  WMhkqq
WMhko1    ke  1 0
WMhkq2    ko  WMhkqqv WMhko1
WMhksq2   ke  774 0
.         ti  WMhksq2 WMhkq2
.         so  WMhkLP

WMhkDN    ke  0 0

WMcq      ke  774 0
WMcqv     ta  WMcq
WMcr      ke  775 0
WMcrv     ta  WMcr
WMct      ke  765 0
WMctv     ta  WMct
WMcz      ke  0 0
.         su  WMctv WMcz WMCI
WMcst     ke  768 0
.         ti  WMcst WMcqv
.         so  WMSGN
WMCI      ke  768 0
WMci2     ko  WMcqv WMcrv
.         ti  WMCI WMci2
.         so  WMSGN

# 反転の回数の偶奇だけが効く
WMSGN     ke  0 0
WMhsq0    ke  0 0
WMhssq    ke  776 0
.         ti  WMhssq WMhsq0
WMhsr0    ke  768 0
WMhsr0v   ta  WMhsr0
WMhssr    ke  777 0
.         ti  WMhssr WMhsr0v

WMhsLP    ke  777 0
WMhsLPv   ta  WMhsLP
WMhst2    ke  2 0
.         se  WMhsLPv WMhst2 WMhsDN
WMhsnt2   si  WMhst2
WMhssub   ko  WMhsLPv WMhsnt2
WMhsss    ke  777 0
.         ti  WMhsss WMhssub
WMhsqq    ke  776 0
WMhsqqv   ta  WMhsqq
WMhso1    ke  1 0
WMhsq2    ko  WMhsqqv WMhso1
WMhssq2   ke  776 0
.         ti  WMhssq2 WMhsq2
.         so  WMhsLP

WMhsDN    ke  0 0

WMsp      ke  777 0
WMspv     ta  WMsp
WMsz      ke  0 0
WMsv0     ke  764 0
WMsv      ta  WMsv0
.         su  WMspv WMsz WMSKP
WMsn      si  WMsv
WMsst2    ke  764 0
.         ti  WMsst2 WMsn
.         so  WMSKP

# 残った先頭。L1 が畳み残せば f1、そうでなければ w2 の k 番目になる
WMSKP     ke  760 0
WMSl1     ta  WMSKP
WMSK2     ke  766 0
WMSk      ta  WMSK2
.         se  WMSk WMSl1 WMSF1
WMSL2     ke  762 0
WMSl2     ta  WMSL2
.         se  WMSk WMSl2 WMSF2
WMSF0     ke  769 0
WMSF0z    ke  0 0
.         ti  WMSF0 WMSF0z
.         so  WMENC

WMSF1     ke  769 0
WMSF1f    ke  761 0
WMSF1v    ta  WMSF1f
.         ti  WMSF1 WMSF1v
.         so  WMENC

# w2 の k 番目は、k が偶数なら f2、奇数なら反対になる
WMhfq0    ke  0 0
WMhfsq    ke  778 0
.         ti  WMhfsq WMhfq0
WMhfr0    ke  766 0
WMhfr0v   ta  WMhfr0
WMhfsr    ke  779 0
.         ti  WMhfsr WMhfr0v

WMhfLP    ke  779 0
WMhfLPv   ta  WMhfLP
WMhft2    ke  2 0
.         se  WMhfLPv WMhft2 WMhfDN
WMhfnt2   si  WMhft2
WMhfsub   ko  WMhfLPv WMhfnt2
WMhfss    ke  779 0
.         ti  WMhfss WMhfsub
WMhfqq    ke  778 0
WMhfqqv   ta  WMhfqq
WMhfo1    ke  1 0
WMhfq2    ko  WMhfqqv WMhfo1
WMhfsq2   ke  778 0
.         ti  WMhfsq2 WMhfq2
.         so  WMhfLP

WMhfDN    ke  0 0

WMSF2     ke  779 0
WMSF2p    ta  WMSF2
WMSF2f    ke  763 0
WMSF2v    ta  WMSF2f
WMSF2o    ke  1 0
WMSF2z    ke  0 0
.         su  WMSF2p WMSF2z WMSFE
WMSF2n    si  WMSF2v
WMSF2m    ko  WMSF2o WMSF2n
WMSF2s    ke  769 0
.         ti  WMSF2s WMSF2m
.         so  WMENC
WMSFE     ke  769 0
.         ti  WMSFE WMSF2v
.         so  WMENC

WMENC     ke  0 0
WMEhq0    ke  0 0
WMEhsq    ke  770 0
.         ti  WMEhsq WMEhq0
WMEhr0    ke  767 0
WMEhr0v   ta  WMEhr0
WMEhsr    ke  771 0
.         ti  WMEhsr WMEhr0v

WMEhLP    ke  771 0
WMEhLPv   ta  WMEhLP
WMEht2    ke  2 0
.         se  WMEhLPv WMEht2 WMEhDN
WMEhnt2   si  WMEht2
WMEhsub   ko  WMEhLPv WMEhnt2
WMEhss    ke  771 0
.         ti  WMEhss WMEhsub
WMEhqq    ke  770 0
WMEhqqv   ta  WMEhqq
WMEho1    ke  1 0
WMEhq2    ko  WMEhqqv WMEho1
WMEhsq2   ke  770 0
.         ti  WMEhsq2 WMEhq2
.         so  WMEhLP

WMEhDN    ke  0 0

WMEq      ke  770 0
WMEqv     ta  WMEq
WMEr      ke  771 0
WMErv     ta  WMEr
WMEse     ke  707 0
.         ti  WMEse WMErv
WMEf      ke  769 0
WMEfv     ta  WMEf
WMEone    ke  1 0
.         su  WMEfv WMEone WMEJJ
WMEnq     si  WMEqv
WMEsi     ke  706 0
.         ti  WMEsi WMEnq
.         so  WMEEN

WMEJJ     ke  0 0
WMEcq     ko  WMEqv WMErv
WMEsj     ke  706 0
.         ti  WMEsj WMEcq
.         so  WMEEN

WMEEN     ke  0 0

.         so  WMRS

# 返り
WMRS      ke  708 0
WMRSs0    ke  764 0
WMRSs     ta  WMRSs0
.         ti  WMRS WMRSs
WMRSg     ke  709 0
WMRSgv    ta  WMRSg
WMRc1     ke  1 0
.         su  WMRSgv WMRc1 WC1R
.         so  BAD

# ================= 構成語の逆元（Quantale.invWord）=================
#
#   引数  語 720-722、返り 語 723-725、戻り符号は語 726
#
# 語をひっくり返す。i の個数は変わらないので符号は動かない

WINV      ke  0 0
WI1m      ke  720 0
WI1mv     ta  WI1m
WI1e      ke  721 0
WI1ev     ta  WI1e
WI1z      ke  0 0
.         se  WI1z WI1mv WI1PJ
.         se  WI1mv WI1z WI1PI
WI1ZF     ke  0 0
WI1zf     ke  761 0
.         ti  WI1zf WI1ZF
WI1zl     ke  760 0
.         ti  WI1zl WI1ev
.         so  WI1EN

WI1PJ     ke  1 0
WI1jf     ke  761 0
.         ti  WI1jf WI1PJ
WI1j2     ke  2 0
WI1j2m    sa  WI1j2 WI1mv
WI1jne    si  WI1ev
WI1jL     ko  WI1j2m WI1jne
WI1jl     ke  760 0
.         ti  WI1jl WI1jL
.         so  WI1EN

WI1PI     ke  0 0
WI1if     ke  761 0
.         ti  WI1if WI1PI
WI1i2     ke  2 0
WI1i2m    sa  WI1i2 WI1mv
WI1ing    si  WI1i2m
WI1iL     ko  WI1ing WI1ev
WI1il     ke  760 0
.         ti  WI1il WI1iL
.         so  WI1EN

WI1EN     ke  0 0

# ひっくり返すと先頭が末尾になる
WIhq0     ke  0 0
WIhsq     ke  772 0
.         ti  WIhsq WIhq0
WIhr0     ke  760 0
WIhr0v    ta  WIhr0
WIhsr     ke  773 0
.         ti  WIhsr WIhr0v

WIhLP     ke  773 0
WIhLPv    ta  WIhLP
WIht2     ke  2 0
.         se  WIhLPv WIht2 WIhDN
WIhnt2    si  WIht2
WIhsub    ko  WIhLPv WIhnt2
WIhss     ke  773 0
.         ti  WIhss WIhsub
WIhqq     ke  772 0
WIhqqv    ta  WIhqq
WIho1     ke  1 0
WIhq2     ko  WIhqqv WIho1
WIhsq2    ke  772 0
.         ti  WIhsq2 WIhq2
.         so  WIhLP

WIhDN     ke  0 0

WIpar     ke  773 0
WIparv    ta  WIpar
WIf       ke  761 0
WIfv      ta  WIf
WIo1      ke  1 0
.         su  WIparv WIo1 WINF
WInn      si  WIfv
WInf      ko  WIo1 WInn
WIst      ke  769 0
.         ti  WIst WInf
.         so  WIEN
WINF      ke  769 0
.         ti  WINF WIfv
.         so  WIEN

WIEN      ke  767 0
WIL       ke  760 0
WILv      ta  WIL
.         ti  WIEN WILv
WIEhq0    ke  0 0
WIEhsq    ke  770 0
.         ti  WIEhsq WIEhq0
WIEhr0    ke  767 0
WIEhr0v   ta  WIEhr0
WIEhsr    ke  771 0
.         ti  WIEhsr WIEhr0v

WIEhLP    ke  771 0
WIEhLPv   ta  WIEhLP
WIEht2    ke  2 0
.         se  WIEhLPv WIEht2 WIEhDN
WIEhnt2   si  WIEht2
WIEhsub   ko  WIEhLPv WIEhnt2
WIEhss    ke  771 0
.         ti  WIEhss WIEhsub
WIEhqq    ke  770 0
WIEhqqv   ta  WIEhqq
WIEho1    ke  1 0
WIEhq2    ko  WIEhqqv WIEho1
WIEhsq2   ke  770 0
.         ti  WIEhsq2 WIEhq2
.         so  WIEhLP

WIEhDN    ke  0 0

WIEq      ke  770 0
WIEqv     ta  WIEq
WIEr      ke  771 0
WIErv     ta  WIEr
WIEse     ke  724 0
.         ti  WIEse WIErv
WIEf      ke  769 0
WIEfv     ta  WIEf
WIEone    ke  1 0
.         su  WIEfv WIEone WIEJJ
WIEnq     si  WIEqv
WIEsi     ke  723 0
.         ti  WIEsi WIEnq
.         so  WIEEN

WIEJJ     ke  0 0
WIEcq     ko  WIEqv WIErv
WIEsj     ke  723 0
.         ti  WIEsj WIEcq
.         so  WIEEN

WIEEN     ke  0 0

WIRS      ke  725 0
WIRSs0    ke  722 0
WIRSs     ta  WIRSs0
.         ti  WIRS WIRSs
WIRSg     ke  726 0
WIRSgv    ta  WIRSg
WIRc1     ke  1 0
.         su  WIRSgv WIRc1 WV1R
WIRc2     ke  2 0
.         su  WIRSgv WIRc2 WV2R
.         so  BAD

# ================= WGATE：門をひとつ掛ける（Descend.gateWords）=================
#
#   引数  語 730 = 並びの先頭、731 = 個数、732 = 掛ける門の箱
#   返り  語 733 = 新しい先頭。戻り符号は語 734

WGATE     ke  733 0
WGAn      ke  97 0
WGAnv     ta  WGAn
.         ti  WGATE WGAnv
WGi       ke  735 0
WGiz      ke  0 0
.         ti  WGi WGiz

WGLP      ke  735 0
WGLPi     ta  WGLP
WGLPn     ke  731 0
WGLPnv    ta  WGLPn
.         se  WGLPi WGLPnv WGLB
.         so  WGDN

WGLB      ke  730 0
WGLBs     ta  WGLB
WGLBi0    ke  735 0
WGLBi     ta  WGLBi0
WGLBk     ko  WGLBs WGLBi
WGg       sa  KV44 BW
WGga      ko  WGg WGLBk
WGgv      ta  WGga
WGm0      ke  732 0
WGm0v     ta  WGm0
WGmul0    ke  6 0
WGmuln    ta  WGmul0
WGmulk    sa  KV04 BW
WGmulka   ko  WGmulk WGmuln
WGmulkv   ke  3 0
.         ti  WGmulka WGmulkv
WGmulaw   sa  KV06 BW
WGmulaa   ko  WGmulaw WGmuln
.         ti  WGmulaa WGm0v
WGmulbw   sa  KV08 BW
WGmulba   ko  WGmulbw WGmuln
.         ti  WGmulba WGgv
WGmuldw   sa  KV10 BW
WGmulda   ko  WGmuldw WGmuln
WGmulz    ke  0 0
.         ti  WGmulda WGmulz
WGmulo1   ke  1 0
WGmuln2   ko  WGmuln WGmulo1
.         ti  WGmul0 WGmuln2

WGgm      sa  KV46 BW
WGgma     ko  WGgm WGLBk
WGgmv     ta  WGgma
WGge      sa  KV48 BW
WGgea     ko  WGge WGLBk
WGgev     ta  WGgea
WGgs      sa  KV50 BW
WGgsa     ko  WGgs WGLBk
WGgsv     ta  WGgsa
WGaln     ke  97 0
WGalnv    ta  WGaln
WGalo     ke  1 0
WGaln2    ko  WGalnv WGalo
WGals     ke  97 0
.         ti  WGals WGaln2
WGpg      sa  KV44 BW
WGpga     ko  WGpg WGalnv
.         ti  WGpga WGmuln
WGpm      sa  KV46 BW
WGpma     ko  WGpm WGalnv
.         ti  WGpma WGgmv
WGpe      sa  KV48 BW
WGpea     ko  WGpe WGalnv
.         ti  WGpea WGgev
WGps      sa  KV50 BW
WGpsa     ko  WGps WGalnv
.         ti  WGpsa WGgsv

WGnx      ke  735 0
WGnxv     ta  WGnx
WGnxo     ke  1 0
WGnx2     ko  WGnxv WGnxo
.         ti  WGnx WGnx2
.         so  WGLP

WGDN      ke  734 0
WGDNv     ta  WGDN
WGc1      ke  1 0
.         su  WGDNv WGc1 WG1R
WGc2      ke  2 0
.         su  WGDNv WGc2 WG2R
WGc3      ke  3 0
.         su  WGDNv WGc3 WG3R
.         so  BAD

# ================= WMERGE：同じ語の門を足す（Descend.mergeWords）=================
#
#   引数  語 755 = 先頭、756 = 個数
#   返り  語 757 = 新しい先頭、759 = 新しい個数。戻り符号は語 758
#
# 先頭から見て、同じ語を持つ後ろの欄を足し込む。足した欄には印を付ける

WMRG      ke  780 0
WMRGz     ke  0 0
.         ti  WMRG WMRGz

# 印を消す
WMFP      ke  780 0
WMFPi     ta  WMFP
WMFPn     ke  756 0
WMFPnv    ta  WMFPn
.         se  WMFPi WMFPnv WMFB
.         so  WMFD
WMFB      ke  755 0
WMFBs     ta  WMFB
WMFBk     ko  WMFBs WMFPi
WMFBz     ke  0 0
WMFBp     sa  KV52 BW
WMFBpa    ko  WMFBp WMFBk
.         ti  WMFBpa WMFBz
WMFBo     ke  1 0
WMFBi2    ko  WMFPi WMFBo
.         ti  WMFP WMFBi2
.         so  WMFP

WMFD      ke  757 0
WMFDn     ke  97 0
WMFDnv    ta  WMFDn
.         ti  WMFD WMFDnv
WMFDc     ke  759 0
WMFDz     ke  0 0
.         ti  WMFDc WMFDz
WMFDi     ke  780 0
.         ti  WMFDi WMFDz

WMKP      ke  780 0
WMKPk     ta  WMKP
WMKPn     ke  756 0
WMKPnv    ta  WMKPn
.         se  WMKPk WMKPnv WMKB
.         so  WMDN

