# commonc 量子層 — compile 時の作図（lane-qbit だけが受ける）
# doc: chamber.def omega.closure beta.def
#
# 量子の語が当たるたびに、Counter 完全状態の ρ = [h] を compile 時に作図する。実行時に
# 残るのは、測定座標 u0 と境界の点の比較だけになる。
#
# ---- 作図の対象 ----
#
#   振幅      ζ = e^{iπ/4} の整数係数 (a, b, c, d) で a + bζ + cζ² + dζ³ を表す。規格化しない
#   状態      枝ごとに 2^NQ 個の振幅。量子ビット q は二分の段 q に当たる。番号 k の振幅と
#             k + 2^q の振幅が、段 q で隣り合う二つの領域の点になる
#   枝        それまでの測定結果の並び x_1 x_2 … で分かれた状態。枝 b の子は 2b + x
#   写像      枝ごとに u0 = (α u + β)/(γ u + δ)（u はいまの測定座標）。成分は Z[√2] の対 (A, B)
#
# ---- 作図 ----
#
#   H   (α0, α1) → (α0 + α1, α0 − α1)     二つの折返しの像の和（平行四辺形）
#   X   (α0, α1) → (α1, α0)               対角の折返し R_ij
#   Z   α1 → −α1                          実軸の折返し R_r
#   S   α1 → ζ² α1        T   α1 → ζ α1   Π_i の回転。ζ (a,b,c,d) = (−d, a, b, c)
#   Y = ζ² X Z、SX = H S H
#   rx ry rz   角の閉包の点 z（QSROT）を対の二点へ当てる
#
#   重み  |α|² = (a² + b² + c² + d²) + √2 (ab + bc + cd − ad)          論文 7.4b
#
# ---- 測定（論文 3.6、3.7、3.16）----
#
#   枝 b の重み w0、w1、N = w0 + w1 から、u0 の側の境界の点 T = (α w0 + β N)/(γ w0 + δ N) を作る。
#   T を二分の作図で 62 桁まで決め、θ = ⌈T·2^62⌉ を image の表へ置く。実行時は
#   x = [θ_b ≤ U0]（u0 = U0/2^62）。各桁の判定は X + Y√2 の符号で、二次形式で決める。
#
#     X ≥ 0、Y ≥ 0  → 非負        X ≥ 0、Y < 0 → [2Y² ≤ X²]
#     X < 0、Y ≤ 0  → 負          X < 0、Y > 0 → [X² ≤ 2Y²]
#
#   測定、移送、メビウス、β_a は、どれも写像へ右から一つの行列を掛ける（QSMUL の説明を見る）
#
# ---- リセット（論文 12.15、12.16）----
#
#   R_C の u の成分は論文に形が無い。host が候補を語 1061 で明示する。
#     1  u を測定と同じく使う。子 1 に X を当てて |0> へ戻す
#   それ以外は失敗にする（候補を黙って選ばない）
#
# ---- 語の割付 ----
#
#   host が置く
#     1000 QBASE   状態の置き場の基底      1001 NBMAX  枝の上限
#     1002 QMAX    量子ビットの上限        1003 TB0    image の作業領域に置く境界の表の基底
#     1061 RC      リセットの u の候補     1062 ANGB 角の表   1063 POWB 2 の冪の表   1064 POWN その長さ
#     1065 ゲートごとの候補の作用の表     1066 回転の作図に足す桁   1067 状態の保存の書き出し場所
#   commonc が持つ
#     1004 初期化の印   1005 NQ   1006 DIM = 2^NQ   1007 NBR 枝の数
#     1008 SB 枝の刻み（4·2^QMAX）   1009 UMB 写像の置き場   1010 TBN 次の表の番地
#     1011 ゲートの番号   1012 q1   1013 q2   1014 S1 = 2^q1   1015 S2 = 2^q2
#     1016 移送の x      1017 b    1018 k    1019 c1   1020 c2   1021 枝の基底
#     1041 走り          1042 いま掛ける作図   1043 SX の段   1048 表の箱
#     1060 入口の種類（1 一量子ビット、2 二量子ビット、3 測定、4 リセット、5 移送、6 回転、7 メビウス）
#     1068 書き出しの位置   1069 回転の数   1070 回転の印   1095 境界の桁が決まらない印
#     1100+k  2^k（k < 64）
#   写像の置き場 UMB + 16b + j
#     j = 0..7  α β γ δ の (A, B)   8..11  w0、w1 の (A, B)   12  届かない枝の印

# ================= 前置き：初期化、量子ビットの番号、状態の拡張 =================

QSPRE     ke  1004 0
QSPf      ta  QSPRE
QSPz      ke  0 0
.         su  QSPf QSPz QSINI
.         so  QSPQ

