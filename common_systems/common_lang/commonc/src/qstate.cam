QSI9b     ke  1010 0
.         ti  QSI9b QSI9a
.         ti  QSI8d QSI1
.         ti  QSI8e QSI1
QSIc      ke  6 0
QSId      ko  QSI8e QSIc
.         ti  QSId QSI1
# 回転の作図が使う 2 の冪の表：POWB + j = 2^j（j < POWN）
QSIP      ke  1063 0
QSIPa     ta  QSIP
.         ti  QSIPa QSI1
QSIPb     ke  1041 0
QSIPc     ko  QSIPa QSI1
.         ti  QSIPb QSIPc
QSIPL     ke  1041 0
QSIPp     ta  QSIPL
QSIPo     ke  1 0
