aSP       ko  bSP kSP2
bxSP      ta  aSP
oASP      sa  KV06 BW
aASP      ko  oASP bxSP
w95SP2    ke  95 0
sSP4      ta  w95SP2
.         ti  aASP sSP4
o1SP3     ke  1 0
kSP3      ko  kSP2 o1SP3
.         ti  SPL kSP3

CNTSP     ke  0 0
SPZ       ke  96 0
kSP4      ta  SPZ
w94SP2    ke  94 0
mSP2      ta  w94SP2
.         se  kSP4 mSP2 SPL
.         so  E3C

E3C       ke  20 0
z20B      ke  0 0
.         ti  E3C z20B

ENTW4B    ke  0 0
L3BW      ke  20 0
iBW       ta  L3BW
w61BW     ke  61 0
nBWo       ta  w61BW
.         se  iBW nBWo L3S
.         so  E4
L3S       ke  20 0
iS        ta  L3S

# 語番号は 256 未満に限る（19 式 2.2）
c256S     ke  256 0
.         se  iS c256S L3S2
.         so  BAD

# 箱 n : Cst(語番号, 0)
L3S2      ke  6 0
nSo        ta  L3S2
oSK       sa  KV04 BW
aSK       ko  oSK nSo
k1S       ke  1 0
.         ti  aSK k1S
bSA       sa  KV06 BW
aSA       ko  bSA nSo
.         ti  aSA iS
dSD       sa  KV10 BW
aSD       ko  dSD nSo
zSo        ke  0 0
.         ti  aSD zSo

# 箱 n+1 : Store(n, 控えたワイヤ)
o1So       ke  1 0
nS2o       ko  nSo o1So
aSK2      ko  oSK nS2o
k5S       ke  5 0
.         ti  aSK2 k5S
aSA2      ko  bSA nS2o
.         ti  aSA2 nSo
bOS       sa  KV03 BW
aOS       ko  bOS iS
wOS       ta  aOS
bSB       sa  KV08 BW
aSB       ko  bSB nS2o
.         ti  aSB wOS
aSD2      ko  dSD nS2o
.         ti  aSD2 zSo

# nBox += 2、語番号 += 1
t2So       ke  2 0
nS3       ko  nSo t2So
.         ti  L3S2 nS3
iS2       ko  iS o1So
.         ti  L3S iS2

CNTW4B    ke  0 0
L3BWz     ke  20 0
iBWz      ta  L3BWz
w61BWz    ke  61 0
nBWz      ta  w61BWz
.         se  iBWz nBWz L3S
.         so  E4                          # 境界に届いた

# ---- 報告の箱 ----
E4        ke  6 0
n4        ta  E4
oEK       sa  KV04 BW
aEK       ko  oEK n4
k6E       ke  6 0
.         ti  aEK k6E
o1E4      ke  1 0
n4b       ko  n4 o1E4
.         ti  E4 n4b

# nNeed = 64 + nBox
c64       ke  64 0
nd        ko  n4b c64
w3N       ke  3 0
.         ti  w3N nd

