# commonc 前段 — .cmn を疑似命令列まで落とす
#
# 仕様は docs/common-compiler/program/19 の第 1 段から第 3 段。
#
#   .cmn  --D_text-->  層  --Desc-->  MBox  --Lower-->  疑似命令
#
# target を知らない。ここから先は後段が受け取る。
#
# ---- 後段へ渡すもの ----
#   BW      刻み B。配列の基底は KVk ⋆ B で引く
#   KV*     配列の倍数。分岐より前に一度だけ立てた定数の箱
#   語 3    nNeed   出来た program が要る語数
#   語 6    nBox    箱の数
#   OPK 4B  種類  1=Cst 2=Add 3=Mul 4=Neg 5=Store 6=Ok
#   OPA 6B  第一引数（Cst では分子）
#   OPB 8B  第二引数
#   OPD 10B 深度
#   OPL 12B 分岐先の箱番号
#
# ---- 後段から借りるもの ----
#   BAD     失敗報告の箱。誤りはすべてここへ分離する
#
# ---- 語の割付（19 §3.1）----
#   0  N        入力の byte 数        host が書く
#   1  IB       本文の基底語番号      host が書く（compile 後は image の基底）
#   1  IMGB     image の基底語番号    commonc が書く
#   2  nImg     image の byte 数      commonc が書く
#   3  nNeed    出来た program が要る語数
#   5  nSyl     音節の数
#   6  nBox     箱の数
#   7  p        入力の走査位置
#   8  i        汎用の走査位置
#   9  fN       入口 frontier の長さ
#  10  cur      層の中の位置
#  11  outN     出口 frontier の長さ
#  12  u        第一引数のワイヤ
#  13  v        第二引数のワイヤ
#  15  emit     IMG への書き出し位置
#  18  ch       読んだ byte
#  19  ci       子音の番号
#  20  j        汎用
#  21  vi       母音の番号
#  23  sy       読んだ音節番号
#  28  ret      層を閉じた後の戻り先。0 = 走査へ、1 = 出力へ
#  36  kind     二項演算の種類
#  40  n0       β が開く四箱の先頭
#  41  n1
#  42  n2
#  43  n3
#  44  du       第一引数の深度
#  45  dv       第二引数の深度
#  46  omd      閉包の深さ
#  47  bx       作った箱の番号
#  48  aW       八箱の A
#  49  bW       八箱の B
#  50  dW       八箱の既定値
#  51  n0W      八箱の先頭
#  52  nIn      共通処理が消費するワイヤ数
#  53  kW       箱の種類
#  54  psh      出口へ積むか
#  55  dpW      箱の深度
#  56  ofs      byte 位置の走り
#  57  su       左シフト a
#  58  sv       左シフト b
#  64〜         入力の byte（一語一 byte）
#
# ---- 採用語彙（16 §1.3〜1.5）。host が本文の前に表を置く ----
# doc: commonc.lexicon plain.lexicon plain.splice
#  130 LEXB     表の byte 数。host が書く。0 なら表は無い
#  131 nLex     見出しの数
#  132 BODY     本文の最初の音節番号
#  133 depth    差し込みの深さ
#  134 tail     語の後ろ。無声ワイヤと層境界だけを許す（16 §1.4）
#  135 names    いま読んでいる見出しの最初の音節番号
#  136 key      引いている鍵
#  137 klen     鍵の長さ（2〜6）
#  138 k        表の走査位置
#  139 rest     語の中の層の先頭で写す本数
#
#  刻み B は host が語 4 へ置けばそれを使う。表を展開すると音節が
#  入力の byte 数より増えるので、host は展開後の大きさで B を決める
#
# ---- 配列（19 §3.2）。刻みは入力から出る ----
#
#   B = N + 80                                                     19 (3.1)
#
# 上限は無い。作業領域が足りなければ host 側で止まる。
#
#   SYL   1B   音節番号。n_syl ≤ N/2
#   FRN   2B   入口 frontier（位置 → 箱番号）
#   FR2   3B   出口 frontier
#   OPK   4B   種類  1=Cst 2=Add 3=Mul 4=Neg 5=Store 6=Ok。容量 2B
#   OPA   6B   第一引数（Cst では分子）
#   OPB   8B   第二引数
#   OPD  10B   深度
#   OPL  12B   分岐先の箱番号
#   DA   14B   変位の byte 0
#   DB   16B   同 byte 1
#   DC   18B   同 byte 2
#   BA   20B   箱の byte 位置の byte 0
#   BB   22B   同 byte 1
#   BC   24B   同 byte 2
#   OMS  25B   閉包の開きスタック
#   IMG  26B   image の byte。箱あたり最大 33 byte、箱は 2B 以下なので 66B 語
#   LEXK 266B  見出しの鍵。Σ k_i·71^(6−i)（i = 1..6）、k = 音節番号 + 1、無い字は 0
#   LEXS 267B  文の最初の音節番号
#   LEXE 268B  文の終わりの音節番号（その次）
#   SPI  269B  差し込みの戻り位置
#   SPQ  270B  差し込んだ位置 q
#   SPE  271B  差し込んだ語の終わり
#   本文  96B   host が置く。IMG の上になる
#
# 箱数は β が最大で四箱を開くので n_box ≤ 4 n_syl ≤ 2N ≤ 2B になる。
#
# 定数はその場で作り直す。長く生かすと landmark が足りなくなる。

# ================= 第 0 段：刻みの算出とスカラの初期化 =================
#
# B = N + 80 を語 4 へ置く（19 式 3.1）。配列の基底はこの倍数になるので、
# 入力の大きさに合わせて自分で伸びる

# host が語 4 に B を置いていればそれを採る
q4H       ke  4 0
B4H       ta  q4H
z4H       ke  0 0
.         su  B4H z4H BCALC
.         so  BOK
BCALC     ke  0 0
N0        ta  BCALC
c80       ke  80 0
Bn        ko  N0 c80
w4B       ke  4 0
.         ti  w4B Bn
flo       ke  4096 0
.         se  flo Bn BOK
.         ti  w4B flo
BOK       ke  4 0
BW        ta  BOK
w1I       ke  1 0
IBW       ta  w1I

# 配列の倍数。分岐より前に一度だけ立てる。以後どの基底も KVk ⋆ B で引く
KV01      ke  1 0
KV02      ke  2 0
KV03      ke  3 0
KV04      ke  4 0
KV06      ke  6 0
KV08      ke  8 0
KV10      ke  10 0
KV12      ke  12 0
KV14      ke  14 0
KV16      ke  16 0
KV18      ke  18 0
KV20      ke  20 0
KV22      ke  22 0
KV24      ke  24 0
KV25      ke  25 0
KV26      ke  26 0
KV27      ke  27 0
KV28      ke  28 0
KV30      ke  30 0
KV32      ke  32 0
KV34      ke  34 0
KV36      ke  36 0
KV38      ke  38 0
KV40      ke  40 0
KV42      ke  42 0
KV44      ke  44 0
KV46      ke  46 0
KV48      ke  48 0
KV50      ke  50 0
KV52      ke  52 0
KV54      ke  54 0
KV266     ke  266 0
KV267     ke  267 0
KV268     ke  268 0
KV269     ke  269 0
KV270     ke  270 0
KV271     ke  271 0
.         so  S0

S0        ke  5 0
z0        ke  0 0
.         ti  S0 z0
c6        ke  6 0
.         ti  c6 z0
c7        ke  7 0
.         ti  c7 z0
c9        ke  9 0
.         ti  c9 z0
c10       ke  10 0
.         ti  c10 z0
c11       ke  11 0
.         ti  c11 z0
c15       ke  15 0
.         ti  c15 z0
c28       ke  28 0
.         ti  c28 z0
c46       ke  46 0
.         ti  c46 z0
c60       ke  60 0
.         ti  c60 z0
c94       ke  94 0
.         ti  c94 z0
c97       ke  97 0
.         ti  c97 z0
c131      ke  131 0
.         ti  c131 z0
c133      ke  133 0
.         ti  c133 z0
c134      ke  134 0
.         ti  c134 z0
c135      ke  135 0
.         ti  c135 z0

# ---- 折返しの符号つき置換（構成語 §7.1）----
#
# D_4 の八元はどれも (r, w) の符号つき置換になる。
#
#   (r, w)  ->  (p·x,  q·y),      (x, y) = (r, w)      s = 0
#                                 (x, y) = (w, r)      s = 1
#
# 符号を 0/1 の三つ組へ詰める。
#
#   code = 4s + 2[p<0] + [q<0]
#
# 表は二つだけになる。8×8 の合成表を持たなくても §7.2 が出る
#
#   語 400+k  番号 k から code へ
#   語 408+c  code から番号 k へ

KTC0      ke  400 0
kt0       ke  0 0
.         ti  KTC0 kt0
KTC1      ke  401 0
kt1       ke  1 0
.         ti  KTC1 kt1
KTC2      ke  402 0
kt2       ke  2 0
.         ti  KTC2 kt2
KTC3      ke  403 0
kt3       ke  4 0
.         ti  KTC3 kt3
KTC4      ke  404 0
kt4       ke  7 0
.         ti  KTC4 kt4
KTC5      ke  405 0
kt5       ke  6 0
.         ti  KTC5 kt5
KTC6      ke  406 0
kt6       ke  5 0
.         ti  KTC6 kt6
KTC7      ke  407 0
kt7       ke  3 0
.         ti  KTC7 kt7

CTK0      ke  408 0
ck0       ke  0 0
.         ti  CTK0 ck0
CTK1      ke  409 0
ck1       ke  1 0
.         ti  CTK1 ck1
CTK2      ke  410 0
ck2       ke  2 0
.         ti  CTK2 ck2
CTK3      ke  411 0
ck3       ke  7 0
.         ti  CTK3 ck3
CTK4      ke  412 0
ck4       ke  3 0
.         ti  CTK4 ck4
CTK5      ke  413 0
ck5       ke  6 0
.         ti  CTK5 ck5
CTK6      ke  414 0
ck6       ke  5 0
.         ti  CTK6 ck6
CTK7      ke  415 0
ck7       ke  4 0
.         ti  CTK7 ck7

# ================= 第 1 段：filter_Σ（16 §1.1）=================
#
# ＡＳＣＩＩ 小文字は必ず音節へ切れる。切れなければ誤りとして上げる。
# 小文字でない字は落とす。空白も改行も注記の全角もここで消える

# ---- 入口。0 回のときは本体へ入らない（§16 の前方分離）----
ENTW0     ke  0 0
L1W0      ke  7 0
p1W0      ta  L1W0
q1W0      ke  0 0
N1W0      ta  q1W0
.         se  p1W0 N1W0 L1
.         so  E1
L1        ke  7 0
p1        ta  L1
q1        ke  0 0
N1        ta  q1

# ---- 表の終わり。本文はここから（BODY = いまの音節数）----
wLXB      ke  130 0
lbv       ta  wLXB
.         su  p1 lbv LXBODY
.         so  LXCONT
LXBODY    ke  132 0
w5LXB     ke  5 0
nSyLXB    ta  w5LXB
.         ti  LXBODY nSyLXB
LXCONT    ke  0 0

L1B       ko  IBW p1
ch        ta  L1B
w18       ke  18 0
.         ti  w18 ch

# ---- 表の中では tab が見出しの終わり、改行が文の終わりになる ----
.         se  p1 lbv LXIN
.         so  LXCH
LXIN      ke  9 0
.         su  ch LXIN LXTAB
LXnl      ke  10 0
.         su  ch LXnl LXNL
LXCH      ke  0 0

a97       ke  97 0
.         se  ch a97 SKIP
a123      ke  123 0
.         se  ch a123 ISL
.         so  SKIP

# ---- tab：見出しの鍵を作り、文の始まりを控える ----
#
# 鍵 = ((k1·71 + k2)·71 + k3)·71 + k4。四音節に満たない分は 0 で埋める
LXTAB     ke  135 0
nmS       ta  LXTAB
w5T       ke  5 0
nSyT      ta  w5T
nnmS      si  nmS
lenT      ko  nSyT nnmS
lxTwo     ke  2 0
.         se  lenT lxTwo BAD
lxSix     ke  7 0
.         se  lenT lxSix LXKEY
.         so  BAD

LXKEY     ke  136 0
zKY       ke  0 0
.         ti  LXKEY zKY
w137T     ke  137 0
.         ti  w137T lenT
w138T     ke  138 0
.         ti  w138T zKY
LXKL      ke  138 0
jKL       ta  LXKL
lxFour    ke  6 0
.         se  jKL lxFour LXKB
.         so  LXSTORE
LXKB      ke  136 0
kyB       ta  LXKB
k71T      ke  71 0
kyB2      sa  kyB k71T
w137B     ke  137 0
lnB       ta  w137B
.         se  jKL lnB LXKC
.         ti  LXKB kyB2
.         so  LXKN
LXKC      ke  135 0
nmC       ta  LXKC
w138C     ke  138 0
lxjC        ta  w138C
ixC       ko  nmC lxjC
bSC       sa  KV01 BW
aC        ko  bSC ixC
sC        ta  aC
lxo1C       ke  1 0
kC        ko  sC lxo1C
w136C     ke  136 0
kyC       ta  w136C
k71C      ke  71 0
kyC2      sa  kyC k71C
kyC3      ko  kyC2 kC
.         ti  w136C kyC3
LXKN      ke  138 0
lxjN        ta  LXKN
o1KN      ke  1 0
jN2       ko  lxjN o1KN
.         ti  LXKN jN2
.         so  LXKL

LXSTORE   ke  131 0
nLx       ta  LXSTORE
bLK       sa  KV266 BW
aLK       ko  bLK nLx
w136c     ke  136 0
keyv      ta  w136c
.         ti  aLK keyv
bLS       sa  KV267 BW
aLS       ko  bLS nLx
w5S2      ke  5 0
nSyS2     ta  w5S2
.         ti  aLS nSyS2
.         so  SKIP

# ---- 改行：文の終わりを控え、次の見出しへ ----
LXNL      ke  131 0
nLxN      ta  LXNL
bLE       sa  KV268 BW
aLE       ko  bLE nLxN
w5N       ke  5 0
nSyN      ta  w5N
.         ti  aLE nSyN
lxo1N       ke  1 0
nLxN2     ko  nLxN lxo1N
.         ti  LXNL nLxN2
w135N     ke  135 0
.         ti  w135N nSyN
.         so  SKIP

SKIP      ke  7 0
ps        ta  SKIP
o1s       ke  1 0
pn        ko  ps o1s
.         ti  SKIP pn
.         so  CNTW0                      # 閉じへ寄せる前方分離

# ---- 子音の番号（19 式 2.1 の ord(c)）----
ISL       ke  18 0
chI       ta  ISL
Lk        ke  107 0
.         su  chI Lk CK
Ls        ke  115 0
.         su  chI Ls CS
Lt        ke  116 0
.         su  chI Lt CT
Ln        ke  110 0
.         su  chI Ln CN
Lh        ke  104 0
.         su  chI Lh CH
Lm        ke  109 0
.         su  chI Lm CM
Ly        ke  121 0
.         su  chI Ly CY
Lr        ke  114 0
.         su  chI Lr CR
Lw        ke  119 0
.         su  chI Lw CW
# 後半の五つは前半と同じ調音位置の有声音になる（10 §1）。
# k–g、s–z、t–d、h–b、h–p の対で、生成規則 σ(c,v) = cv は変わらない
Lg        ke  103 0
.         su  chI Lg CG
Lz        ke  122 0
.         su  chI Lz CZ
Ld        ke  100 0
.         su  chI Ld CD
Lb        ke  98 0
.         su  chI Lb CB
Lp        ke  112 0
.         su  chI Lp CP
.         so  BAD

CK        ke  19 0
vK        ke  0 0
.         ti  CK vK
.         so  CID
CS        ke  19 0
vS        ke  1 0
.         ti  CS vS
.         so  CID
CT        ke  19 0
vT        ke  2 0
.         ti  CT vT
.         so  CID
CN        ke  19 0
vN        ke  3 0
.         ti  CN vN
.         so  CID
CH        ke  19 0
vH        ke  4 0
.         ti  CH vH
.         so  CID
CM        ke  19 0
vM        ke  5 0
.         ti  CM vM
.         so  CID
CY        ke  19 0
vY        ke  6 0
.         ti  CY vY
.         so  CID
CR        ke  19 0
vR        ke  7 0
.         ti  CR vR
.         so  CID
CW        ke  19 0
vW        ke  8 0
.         ti  CW vW
.         so  CID
CG        ke  19 0
cvG       ke  9 0
.         ti  CG cvG
.         so  CID
CZ        ke  19 0
cvZ       ke  10 0
.         ti  CZ cvZ
.         so  CID
CD        ke  19 0
cvD       ke  11 0
.         ti  CD cvD
.         so  CID
CB        ke  19 0
cvB       ke  12 0
.         ti  CB cvB
.         so  CID
CP        ke  19 0
cvP       ke  13 0
.         ti  CP cvP
.         so  CID

# ---- 次の byte は母音になる ----
CID       ke  7 0
pC        ta  CID
o1c       ke  1 0
p2        ko  pC o1c
q2        ke  0 0
N2        ta  q2
.         se  p2 N2 VOW
.         so  BAD

VOW       ko  IBW p2
ch2       ta  VOW
w20       ke  20 0
.         ti  w20 ch2

Vw        ke  20 0
c2        ta  Vw
Va        ke  97 0
.         su  c2 Va VA
Vi        ke  105 0
.         su  c2 Vi VI
Vu        ke  117 0
.         su  c2 Vu VU
Ve        ke  101 0
.         su  c2 Ve VE
Vo        ke  111 0
.         su  c2 Vo VO
.         so  BAD

VA        ke  21 0
uA        ke  0 0
.         ti  VA uA
.         so  SYE
VI        ke  21 0
