.         ti  VE uE
.         so  SYE
VO        ke  21 0
uO        ke  4 0
.         ti  VO uO
.         so  SYE

# ---- 音節番号 = 5·ci + vi ----
SYE       ke  19 0
ciV       ta  SYE
w21       ke  21 0
viV       ta  w21
f5        ke  5 0
m5        sa  ciV f5
sV        ko  m5 viV

w5S       ke  5 0
nS        ta  w5S
bSY       sa  KV01 BW
adS       ko  bSY nS
.         ti  adS sV
o1S       ke  1 0
nS2       ko  nS o1S
.         ti  w5S nS2

w7S       ke  7 0
pS        ta  w7S
t2S       ke  2 0
pS2       ko  pS t2S
.         ti  w7S pS2
# ---- 閉じ。集積境界の内側にいる間は本体へ戻る ----
CNTW0     ke  0 0
L1W0z     ke  7 0
p1W0z     ta  L1W0z
q1W0z     ke  0 0
N1W0z     ta  q1W0z
.         se  p1W0z N1W0z L1
.         so  E1                         # 境界に届いた

# ================= 第 2 段：層の走査と降下（16 §1.2、§5）=================
#
# 層境界音が層を切り、無声ワイヤ音が恒等箱ひとつを表す。
# 平文では恒等箱が明示されるので、箱は必ず現在位置から入力を取る。
# したがって descLayer の skipped は常に空になる

E1        ke  8 0
w132E1    ke  132 0
bodyE1    ta  w132E1
.         ti  E1 bodyE1

# ---- 入口。0 回のときは本体へ入らない（§16 の前方分離）----
ENTW1     ke  0 0
L2W1      ke  8 0
i2W1      ta  L2W1
w5LW1     ke  5 0
nSyW1     ta  w5LW1
.         se  i2W1 nSyW1 L2
.         so  E2
# ---- 差し込んだ語の終わりに着いたら戻り位置へ戻る。入れ子の終わりが重なれば繰り返す ----
L2        ke  133 0
dP        ta  L2
zP        ke  0 0
.         su  dP zP L2S
lxo1P       ke  1 0
lxnP        si  lxo1P
dP1       ko  dP lxnP
bXP       sa  KV271 BW
aXP       ko  bXP dP1
endP      ta  aXP
w8P       ke  8 0
iP        ta  w8P
.         su  iP endP LXPOP
.         so  L2S
LXPOP     sa  KV269 BW
aIP       ko  LXPOP dP1
retP      ta  aIP
w8P2      ke  8 0
.         ti  w8P2 retP
w133P     ke  133 0
.         ti  w133P dP1
w134P     ke  134 0
lxo1P2      ke  1 0
.         ti  w134P lxo1P2
.         so  L2

L2S       ke  8 0
i2        ta  L2S
w5L       ke  5 0
nSy       ta  w5L

L2B       sa  KV01 BW
adL       ko  L2B i2
sy        ta  adL
w23       ke  23 0
.         ti  w23 sy
o12       ke  1 0
i2n       ko  i2 o12
.         ti  L2S i2n

w23b      ke  23 0
sy2       ta  w23b
# ---- 語の後ろに置けるのは無声ワイヤと層境界だけ（16 §1.4）----
wTL       ke  134 0
tlv       ta  wTL
zTL       ke  0 0
