LRG3      ke  712 0
aRGA3     ta  LRG3
t2RGA3    ke  2 0
aRGA3b    sa  t2RGA3 aRGA3
.         ti  LRG3 aRGA3b
w715RGAb  ke  715 0
kRGA3b    ta  w715RGAb
o1RGA3b   ke  1 0
kRGA3c    ko  kRGA3b o1RGA3b
.         ti  w715RGAb kRGA3c
CNTRG3    ke  0 0
LRG3Ez    ke  715 0
