.         ti  CSNX qCS4
w715CSn   ke  715 0
kCS0n     ta  w715CSn
o1CS0n    ke  1 0
kCS0c     ko  kCS0n o1CS0n
.         ti  w715CSn kCS0c
CNTCS0    ke  0 0
LCS0Ez    ke  715 0
kCS0z     ta  LCS0Ez
n32CSz    ke  32 0
.         se  kCS0z n32CSz LCS0
.         so  CHPSH

# ================= 出口境界での実体化 =================
#
# 領域は 1 + |A| 語、鎖は 1 + 3·|∂| 語へ開く。Haskell の matValue と
# 同じ並びにする。cell は昇順で出る。

GMAT      ke  712 0
bGM       sa  KV28 BW
aGM       ko  bGM idCV
mGM       ta  aGM
.         ti  GMAT mGM
w720GM    ke  720 0
o1GM      ke  1 0
.         ti  w720GM o1GM
.         so  RDEC

GMAT1     ke  731 0
zGM1      ke  0 0
.         ti  GMAT1 zGM1
w715GM1   ke  715 0
.         ti  w715GM1 zGM1
ENTGM1    ke  0 0
LGM1E     ke  715 0
kGM1      ta  LGM1E
n32GM     ke  32 0
.         se  kGM1 n32GM LGM1
.         so  GMAT2
LGM1      ke  640 0
w715GM1b  ke  715 0
kGM1b     ta  w715GM1b
aGM1      ko  LGM1 kGM1b
vGM1      ta  aGM1
w731GM1   ke  731 0
