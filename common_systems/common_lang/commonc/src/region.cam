# commonc 領域層 — 幾何連合論理集合 Index の Level 0 を compile 時に畳む
#
# Level 0 の操作は四つで尽きる。
#
#   共通部  A ∩ B      合わせ  A ∪ B      外側  U ∖ A      境界  ∂A
#
# 関係はこの四つの上の述語になる。
#
#   重なり   A ∩ B ≠ ∅
#   含まれる B ∖ A = ∅
#   隣接     A ∩ B = ∅ かつ (2A ∩ B) ∪ (A ∩ 2B) ≠ ∅
#   道       A ≠ ∅ かつ立っている cell が一続き
#
# ---- 表し方 ----
#
# 領域は cell の集合であり、cell は 31 個までなので一語の mask に収まる。
# 名詞ノードの構成語 D∞ = ⟨i, j | i² = j² = e⟩ が cell 番号を決める。
#
#   (m, ε) から  cell = 2·zz(m) + ε、  zz(m) = 2m (m ≥ 0)、−2m−1 (m < 0)
#
# zz は単射なので、別のノードが同じ単位領域を指すことは無い。
#
# 鎖は cell 上の係数で持つ。影響の係数は {−1, 0, 1} に限られる（影響関数
# 証明3.2）ので、負側と正側の二つの mask で尽きる。
#
#   ∂A の係数(v) = [v−1 ∈ A] − [v ∈ A]
#   正側 = 2A ∖ A     負側 = A ∖ 2A
#
# 2A は mask の倍。左シフトが乗算そのものなので箱を作らずに済む。
# だから mask は bit 31 まで使う。
#
# ---- 値の種類 ----
#
#   34  領域   欄 0 = mask
#   35  鎖     欄 0 = 負側の mask、欄 1 = 正側の mask
#
# ---- 語の割付 ----
#
#   640..671  IA[k]   指示ベクトル。mask を分解した置き場
#   680..711  SUM[k]  cell ごとの係数の和
#   712  RGA    第一の mask       713  RGB    第二の mask
#   714  RGR    結果の mask       715  RGK    走査の添字
#   716  RGT    分解の余り
#   717  RGC2   ab の係数    結果 = c2·ab + c1·a + c0·b
#   718  RGC1   a の係数     719  RGC0   b の係数
#   720  RGRET  部分手続きの戻り先
#   721  RGN1   鎖 A の負側       722  RGP1   鎖 A の正側
#   723  RGN2   鎖 B の負側       724  RGP2   鎖 B の正側
#   725  RGOP   どの語を処理しているか
#   726  RGP    2 冪              727  RGE    その指数
#   728  RGZZ   ジグザグの値      729  RGBT   b の bit
#   731  RGCN   数え上げ／走りの数
#   732  RGRA   分解の余り A      733  RGRB   分解の余り B
#   736  RGSA   第一引数の控え    737  RGSB   第二引数の控え
#   738  RGSG   鎖の加算で足す符号
#   740  EMV    出す語の値        741  EMR    出した後の戻り先
#   742  RGBV   関係が出した二値
#
# 11 原子には除算も bit 演算も無い。だから分解は「引ける最大の 2 冪を引く」で
# 書く。倍加の内側ループが指数を数え、外側ループが余りを削る。

# ================= 三音節の名前を読む（10 §4）=================
#
# 頭の ku は零標示音であり、どの一音節名とも一致しない。だから ku を見たら
# 続く二音節が桁になる。
#
#   g = 63 + 60·(a − 3) + (b − 3)
#
# 音節が二つ足りないときは零標示のまま落とす。本文全体が ku 一つのときが
# 空本体になる（06 §16.3）。

GKU       ke  8 0
iKU       ta  GKU
o2KU      ke  2 0
iKU2      ko  iKU o2KU
w5KU      ke  5 0
nKU       ta  w5KU
.         se  nKU iKU2 ENTW1
KU1       sa  KV01 BW
aKU1      ko  KU1 iKU
sKU1      ta  aKU1
o1KU1     ke  1 0
iKU1b     ko  iKU o1KU1
aKU2      ko  KU1 iKU1b
sKU2      ta  aKU2
w8KU      ke  8 0
.         ti  w8KU iKU2

t3KU      ke  3 0
nt3KU     si  t3KU
qKU       ko  sKU1 nt3KU
n60KU     ke  60 0
qKU2      sa  qKU n60KU
rKU       ko  sKU2 nt3KU
gKU0      ko  qKU2 rKU
n63KU     ke  63 0
gKU       ko  gKU0 n63KU

g63       ke  63 0
.         su  gKU g63 GRGAT              # 領域
g64       ke  64 0
.         su  gKU g64 GRGCAP             # 共通部
g65       ke  65 0
.         su  gKU g65 GRGCUP             # 合わせ
g66       ke  66 0
.         su  gKU g66 GRGOUT             # 外側
g67       ke  67 0
.         su  gKU g67 GRGBD              # 境界
g68       ke  68 0
.         su  gKU g68 GRGIN              # 含まれる
g69       ke  69 0
.         su  gKU g69 GRGOV              # 重なり
g70       ke  70 0
.         su  gKU g70 GRGAJ              # 隣接
g71       ke  71 0
.         su  gKU g71 GRGPA              # 道
.         so  GKUQ                       # 量子の語（qbit.cam）。無ければ noqbit.cam が BAD へ送る

# ================= 部分手続き：mask を分解する =================
#
# RGA の立っている cell を IA[0..31] へ広げる。
# 外側のループが余りを削り、内側のループが「引ける最大の 2 冪」を作る。

RDEC      ke  715 0
zDC0      ke  0 0
.         ti  RDEC zDC0
ENTDC0    ke  0 0
LDC0E     ke  715 0
kDC0      ta  LDC0E
n32DC     ke  32 0
.         se  kDC0 n32DC LDC0
.         so  RDE1
LDC0      ke  640 0
w715DC    ke  715 0
kDC0b     ta  w715DC
aDC0      ko  LDC0 kDC0b
zDC0b     ke  0 0
.         ti  aDC0 zDC0b
o1DC0     ke  1 0
kDC0c     ko  kDC0b o1DC0
.         ti  w715DC kDC0c
CNTDC0    ke  0 0
LDC0Ez    ke  715 0
kDC0z     ta  LDC0Ez
n32DCz    ke  32 0
.         se  kDC0z n32DCz LDC0
.         so  RDE1

RDE1      ke  716 0
w712D1    ke  712 0
vDR1       ta  w712D1
.         ti  RDE1 vDR1

ENTDC1    ke  0 0
LDC1E     ke  716 0
tDC1      ta  LDC1E
zDC1      ke  0 0
.         se  zDC1 tDC1 LDC1
.         so  RDEND
LDC1      ke  726 0
o1DC1     ke  1 0
.         ti  LDC1 o1DC1
w727D     ke  727 0
zDC1b     ke  0 0
.         ti  w727D zDC1b

ENTDC2    ke  0 0
LDC2E     ke  726 0
pDC2      ta  LDC2E
t2DC2     ke  2 0
p2DC2     sa  t2DC2 pDC2
w716D2    ke  716 0
rDC2      ta  w716D2
o1DC2     ke  1 0
r1DC2     ko  rDC2 o1DC2
.         se  p2DC2 r1DC2 LDC2
.         so  LDC3
LDC2      ke  726 0
pDC2b     ta  LDC2
t2DC2b    ke  2 0
pDC2c     sa  t2DC2b pDC2b
.         ti  LDC2 pDC2c
w727D2    ke  727 0
eDC2      ta  w727D2
o1DC2b    ke  1 0
eDC2b     ko  eDC2 o1DC2b
.         ti  w727D2 eDC2b
CNTDC2    ke  0 0
LDC2Ez    ke  726 0
pDC2z     ta  LDC2Ez
t2DC2z    ke  2 0
p2DC2z    sa  t2DC2z pDC2z
w716D2z   ke  716 0
rDC2z     ta  w716D2z
o1DC2z    ke  1 0
r1DC2z    ko  rDC2z o1DC2z
.         se  p2DC2z r1DC2z LDC2
.         so  LDC3

LDC3      ke  640 0
w727D3    ke  727 0
eDC3      ta  w727D3
aDC3      ko  LDC3 eDC3
o1DC3     ke  1 0
.         ti  aDC3 o1DC3
w716D3    ke  716 0
rDC3      ta  w716D3
w726D3    ke  726 0
pDC3      ta  w726D3
npDC3     si  pDC3
rDC3b     ko  rDC3 npDC3
.         ti  w716D3 rDC3b
CNTDC1    ke  0 0
LDC1Ez    ke  716 0
tDC1z     ta  LDC1Ez
zDC1z     ke  0 0
.         se  zDC1z tDC1z LDC1
.         so  RDEND

RDEND     ke  720 0
gDC       ta  RDEND
d1DC      ke  1 0
.         su  gDC d1DC GMAT1
d2DC      ke  2 0
.         su  gDC d2DC CMAT1
d3DC      ke  3 0
.         su  gDC d3DC CACC
d4DC      ke  4 0
.         su  gDC d4DC CACC
d5DC      ke  5 0
.         su  gDC d5DC CACC
d6DC      ke  6 0
.         su  gDC d6DC CACC
d7DC      ke  7 0
.         su  gDC d7DC RPAT1
d8DC      ke  8 0
.         su  gDC d8DC CMAT3
.         so  BAD

# ================= 部分手続き：二つの mask を合わせる =================
#
#   RGR = Σ_k ( c2·a_k·b_k + c1·a_k + c0·b_k ) · 2^k
#
# 三つの係数で共通部・合わせ・外側のどれにもなる。
#
#   共通部  ( 1, 0, 0)     合わせ  (−1, 1, 1)     外側 A ∖ B  (−1, 1, 0)
#
# 2 冪の表を持たないので、p は 2^31 から始めて毎回作り直す。

ROP       ke  714 0
zOP0      ke  0 0
.         ti  ROP zOP0
w732OP0   ke  732 0
w712OP0   ke  712 0
aOP0      ta  w712OP0
.         ti  w732OP0 aOP0
w733OP0   ke  733 0
w713OP0   ke  713 0
bOP0      ta  w713OP0
.         ti  w733OP0 bOP0
w726OP    ke  726 0
o1OP0     ke  1 0
.         ti  w726OP o1OP0
w715OP    ke  715 0
zOP0b     ke  0 0
.         ti  w715OP zOP0b

ENTOP0    ke  0 0
LOP0E     ke  715 0
kOP0      ta  LOP0E
n31OP     ke  31 0
.         se  kOP0 n31OP LOP0
.         so  ENTOP1
LOP0      ke  726 0
pOP0      ta  LOP0
t2OP0     ke  2 0
pOP0b     sa  t2OP0 pOP0
.         ti  LOP0 pOP0b
w715OPb   ke  715 0
kOP0b     ta  w715OPb
o1OP0b    ke  1 0
kOP0c     ko  kOP0b o1OP0b
.         ti  w715OPb kOP0c
CNTOP0    ke  0 0
LOP0Ez    ke  715 0
kOP0z     ta  LOP0Ez
n31OPz    ke  31 0
.         se  kOP0z n31OPz LOP0
.         so  ENTOP1

ENTOP1    ke  0 0
LOP1E     ke  726 0
pOP1E     ta  LOP1E
zOP1E     ke  0 0
.         se  zOP1E pOP1E LOP1
.         so  ROPND

LOP1      ke  731 0
zOP1b     ke  0 0
.         ti  LOP1 zOP1b
w732OP    ke  732 0
raOP      ta  w732OP
w726OP1   ke  726 0
pOP1b     ta  w726OP1
.         se  raOP pOP1b LOPA0
o1OPA     ke  1 0
.         ti  LOP1 o1OPA
npOPA     si  pOP1b
raOPb     ko  raOP npOPA
.         ti  w732OP raOPb

LOPA0     ke  729 0
zOPB0     ke  0 0
.         ti  LOPA0 zOPB0
w733OP1   ke  733 0
rbOP      ta  w733OP1
w726OP2   ke  726 0
pOP1c     ta  w726OP2
.         se  rbOP pOP1c LOPB0
o1OPB     ke  1 0
.         ti  LOPA0 o1OPB
npOPB     si  pOP1c
rbOPb     ko  rbOP npOPB
.         ti  w733OP1 rbOPb

LOPB0     ke  731 0
aBIT      ta  LOPB0
w729OP    ke  729 0
bBIT      ta  w729OP
abOP      sa  aBIT bBIT
w717OP    ke  717 0
c2OP      ta  w717OP
w718OP    ke  718 0
c1OP      ta  w718OP
w719OP    ke  719 0
c0OP      ta  w719OP
t2OPv     sa  c2OP abOP
t1OPv     sa  c1OP aBIT
t0OPv     sa  c0OP bBIT
sOPv0     ko  t2OPv t1OPv
sOPv      ko  sOPv0 t0OPv
o1OPv     ke  1 0
.         se  sOPv o1OPv LOPNX
w714OP    ke  714 0
rOPv      ta  w714OP
w726OP3   ke  726 0
pOPv      ta  w726OP3
rOPv2     ko  rOPv pOPv
.         ti  w714OP rOPv2

# p を半分にする。半分は「2q が p に届かない最大の q」として倍加で作る
LOPNX     ke  726 0
pOPN      ta  LOPNX
o1OPN     ke  1 0
.         su  pOPN o1OPN ROPND
w738OPN   ke  738 0
.         ti  w738OPN pOPN                # 元の p を控える
.         ti  LOPNX o1OPN                 # q = 1

ENTOP2    ke  0 0
LOP2E     ke  726 0
pOP2      ta  LOP2E
t2OP2     ke  2 0
p2OP2     sa  t2OP2 pOP2
w738OP2   ke  738 0
oldOP2    ta  w738OP2
.         se  p2OP2 oldOP2 LOP2
.         so  ENTOP1
LOP2      ke  726 0
pOP2b     ta  LOP2
t2OP2b    ke  2 0
pOP2c     sa  t2OP2b pOP2b
.         ti  LOP2 pOP2c
CNTOP2    ke  0 0
LOP2Ez    ke  726 0
pOP2z     ta  LOP2Ez
t2OP2z    ke  2 0
p2OP2z    sa  t2OP2z pOP2z
w738OP2z  ke  738 0
oldOP2z   ta  w738OP2z
.         se  p2OP2z oldOP2z LOP2
.         so  ENTOP1

ROPND     ke  720 0
gOP       ta  ROPND
e1OP      ke  1 0
.         su  gOP e1OP GCAP1
e2OP      ke  2 0
.         su  gOP e2OP GCUP1
e3OP      ke  3 0
.         su  gOP e3OP GOUT1
e4OP      ke  4 0
.         su  gOP e4OP GIN1
e5OP      ke  5 0
.         su  gOP e5OP GOV1
e6OP      ke  6 0
.         su  gOP e6OP GBD1
e7OP      ke  7 0
.         su  gOP e7OP GBD2
e8OP      ke  8 0
.         su  gOP e8OP GAJ1
e9OP      ke  9 0
.         su  gOP e9OP GAJ2
e10OP     ke  10 0
.         su  gOP e10OP GAJ3
.         so  BAD

# ---- 係数を置いて ROP を呼ぶ短縮形 ----
SETCAP    ke  717 0
o1SC      ke  1 0
.         ti  SETCAP o1SC
w718SC    ke  718 0
zSC       ke  0 0
.         ti  w718SC zSC
w719SC    ke  719 0
.         ti  w719SC zSC
.         so  ROP

SETCUP    ke  717 0
o1SU      ke  1 0
nSU       si  o1SU
.         ti  SETCUP nSU
w718SU    ke  718 0
.         ti  w718SU o1SU
w719SU    ke  719 0
.         ti  w719SU o1SU
.         so  ROP

SETOUT    ke  717 0
o1SO      ke  1 0
nSO       si  o1SO
.         ti  SETOUT nSO
w718SO    ke  718 0
.         ti  w718SO o1SO
w719SO    ke  719 0
zSO       ke  0 0
.         ti  w719SO zSO
.         so  ROP

# ================= 領域：Noun → Region =================

GRGAT     ke  69 0
t40RG     ke  40 0
.         ti  GRGAT t40RG
.         so  RD1

R1RGA     ke  62 0
