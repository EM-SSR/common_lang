.         so  BAD                         # cell が網の外へ出た

RGAT3     ke  712 0
o1RGA3    ke  1 0
.         ti  RGAT3 o1RGA3
w715RGA   ke  715 0
zRGA3     ke  0 0
.         ti  w715RGA zRGA3
ENTRG3    ke  0 0
LRG3E     ke  715 0
kRGA3     ta  LRG3E
w729RGAz  ke  729 0
cRGA3     ta  w729RGAz
.         se  kRGA3 cRGA3 LRG3
