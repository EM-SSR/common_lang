.         ti  GMAT2 cGM2
w741GM2   ke  741 0
o1GM2     ke  1 0
.         ti  w741GM2 o1GM2
.         so  EMITW

GMAT3     ke  715 0
zGM3      ke  0 0
.         ti  GMAT3 zGM3
ENTGM3    ke  0 0
LGM3E     ke  715 0
kGM3      ta  LGM3E
n32GM3    ke  32 0
.         se  kGM3 n32GM3 LGM3
.         so  L3NX
LGM3      ke  640 0
w715GM3   ke  715 0
kGM3b     ta  w715GM3
aGM3      ko  LGM3 kGM3b
vGM3      ta  aGM3
zGM3b     ke  0 0
.         su  vGM3 zGM3b GM3NX
w740GM3   ke  740 0
.         ti  w740GM3 kGM3b
w741GM3   ke  741 0
t2GM3     ke  2 0
.         ti  w741GM3 t2GM3
.         so  EMITW
GM3NX     ke  715 0
