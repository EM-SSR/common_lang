.         ti  w720CA t3CA
.         so  RDEC

CACCA     ke  712 0
w722CB    ke  722 0
p1CB      ta  w722CB
.         ti  CACCA p1CB
w738CB    ke  738 0
o1CB      ke  1 0
.         ti  w738CB o1CB
w720CB    ke  720 0
t4CB      ke  4 0
.         ti  w720CB t4CB
.         so  RDEC

CACCB     ke  712 0
w723CC    ke  723 0
n2CC      ta  w723CC
.         ti  CACCB n2CC
w738CC    ke  738 0
o1CC2     ke  1 0
nCC3      si  o1CC2
.         ti  w738CC nCC3
w720CC    ke  720 0
t5CC      ke  5 0
.         ti  w720CC t5CC
.         so  RDEC

CACCC     ke  712 0
w724CD    ke  724 0
p2CD      ta  w724CD
.         ti  CACCC p2CD
w738CD    ke  738 0
o1CD      ke  1 0
.         ti  w738CD o1CD
w720CD    ke  720 0
t6CD      ke  6 0
.         ti  w720CD t6CD
.         so  RDEC

# 指示ベクトルを符号つきで SUM へ足す
CACC      ke  715 0
zCC0      ke  0 0
.         ti  CACC zCC0
ENTCC0    ke  0 0
LCC0E     ke  715 0
kCC0      ta  LCC0E
n32CC     ke  32 0
.         se  kCC0 n32CC LCC0
.         so  CACCX
LCC0      ke  640 0
w715CC0   ke  715 0
kCC0b     ta  w715CC0
aCC0      ko  LCC0 kCC0b
vCC0      ta  aCC0
w738CC0   ke  738 0
