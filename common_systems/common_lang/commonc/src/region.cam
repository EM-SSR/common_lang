# SUM から負側と正側の mask を作る。|和| = 2 は鎖にならない
CSUM      ke  721 0
zCS       ke  0 0
.         ti  CSUM zCS
w722CS    ke  722 0
.         ti  w722CS zCS
w726CS    ke  726 0
