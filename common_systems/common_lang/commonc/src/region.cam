.         ti  w715GM1b kGM1c
CNTGM1    ke  0 0
LGM1Ez    ke  715 0
kGM1z     ta  LGM1Ez
n32GMz    ke  32 0
.         se  kGM1z n32GMz LGM1
.         so  GMAT2

GMAT2     ke  740 0
w731GM2   ke  731 0
