t2DU      ke  2 0
.         ti  DOCUP t2DU
.         so  SETCUP
GCUP1     ke  0 0
.         so  RGPSHR

# ---- 外側。第一引数を宇宙、第二引数を抜く側に取る ----
DOOUT     ke  720 0
t3DO      ke  3 0
.         ti  DOOUT t3DO
.         so  SETOUT
GOUT1     ke  0 0
.         so  RGPSHR

# ---- 結果の mask を領域として積む ----
RGPSHR    ke  712 0
w714PR    ke  714 0
rPR       ta  w714PR
.         ti  RGPSHR rPR
.         so  RGPSH

# ================= 関係 =================
#
# 含まれる A ⊇ B は B ∖ A が空であること。外側の式へ引数を入れ替えて渡す。

DOIN      ke  712 0
w713DI    ke  713 0
bDI       ta  w713DI
w736DI    ke  736 0
aDI       ta  w736DI
.         ti  DOIN bDI
.         ti  w713DI aDI
w720DI    ke  720 0
t4DI      ke  4 0
.         ti  w720DI t4DI
.         so  SETOUT
GIN1      ke  714 0
rIN       ta  GIN1
zIN       ke  0 0
.         su  rIN zIN BITON
.         so  BITOFF

# 重なり A ∩ B ≠ ∅
DOOV      ke  720 0
t5DO      ke  5 0
.         ti  DOOV t5DO
.         so  SETCAP
GOV1      ke  714 0
rOV       ta  GOV1
zOV       ke  0 0
.         su  rOV zOV BITOFF
.         so  BITON

# 隣接。境界を共有し、内部を共有しない
DOAJ      ke  720 0
t8DA      ke  8 0
.         ti  DOAJ t8DA
.         so  SETCAP
GAJ1      ke  714 0
rAJ1      ta  GAJ1
zAJ1      ke  0 0
.         su  rAJ1 zAJ1 AJ2
.         so  BITOFF

AJ2       ke  712 0
w736AJ2   ke  736 0
sAJ2      ta  w736AJ2
t2AJ2     ke  2 0
sAJ2b     sa  t2AJ2 sAJ2
.         ti  AJ2 sAJ2b                   # RGA = 2A
w713AJ2   ke  713 0
w737AJ2   ke  737 0
bAJ2      ta  w737AJ2
.         ti  w713AJ2 bAJ2                # RGB = B
w720AJ2   ke  720 0
t9AJ2     ke  9 0
.         ti  w720AJ2 t9AJ2
.         so  SETCAP
GAJ2      ke  714 0
rAJ2      ta  GAJ2
zAJ2      ke  0 0
.         su  rAJ2 zAJ2 AJ3
.         so  BITON

AJ3       ke  712 0
w736AJ3   ke  736 0
sAJ3      ta  w736AJ3
.         ti  AJ3 sAJ3                    # RGA = A
w713AJ3   ke  713 0
w737AJ3   ke  737 0
bAJ3      ta  w737AJ3
t2AJ3     ke  2 0
bAJ3b     sa  t2AJ3 bAJ3
.         ti  w713AJ3 bAJ3b               # RGB = 2B
w720AJ3   ke  720 0
t10AJ3    ke  10 0
.         ti  w720AJ3 t10AJ3
.         so  SETCAP
GAJ3      ke  714 0
rAJ3      ta  GAJ3
zAJ3      ke  0 0
.         su  rAJ3 zAJ3 BITOFF
.         so  BITON

# 道。分解した指示ベクトルを下から見て、0 から 1 へ変わる回数を数える。
# 一続きならその回数はちょうど一つになる
GRGPA     ke  69 0
t46PA     ke  46 0
.         ti  GRGPA t46PA
.         so  RD1

R1RGP     ke  62 0
kRGP      ta  R1RGP
t34RGP    ke  34 0
.         su  kRGP t34RGP RGPA0
.         so  BAD

RGPA0     ke  712 0
w63PA     ke  63 0
mPA       ta  w63PA
.         ti  RGPA0 mPA
w720PA    ke  720 0
t7PA      ke  7 0
.         ti  w720PA t7PA
.         so  RDEC

RPAT1     ke  731 0
zPA1      ke  0 0
.         ti  RPAT1 zPA1
w732PA    ke  732 0
.         ti  w732PA zPA1
w715PA    ke  715 0
.         ti  w715PA zPA1
ENTPA1    ke  0 0
LPA1E     ke  715 0
kPA1      ta  LPA1E
n32PA     ke  32 0
.         se  kPA1 n32PA LPA1
.         so  PAEND
LPA1      ke  640 0
w715PAb   ke  715 0
kPA1b     ta  w715PAb
aPA1      ko  LPA1 kPA1b
vPA1      ta  aPA1
w732PAb   ke  732 0
pvPA1     ta  w732PAb
zPA1b     ke  0 0
.         su  vPA1 zPA1b PANX
.         su  pvPA1 zPA1b PARUN
.         so  PANX
PARUN     ke  731 0
cPA1      ta  PARUN
o1PA1     ke  1 0
cPA1b     ko  cPA1 o1PA1
.         ti  PARUN cPA1b
PANX      ke  732 0
w640PAn   ke  640 0
w715PAn   ke  715 0
kPA1n     ta  w715PAn
aPA1n     ko  w640PAn kPA1n
vPA1n     ta  aPA1n
.         ti  PANX vPA1n
o1PA1n    ke  1 0
kPA1c     ko  kPA1n o1PA1n
.         ti  w715PAn kPA1c
CNTPA1    ke  0 0
LPA1Ez    ke  715 0
kPA1z     ta  LPA1Ez
n32PAz    ke  32 0
.         se  kPA1z n32PAz LPA1
.         so  PAEND

PAEND     ke  731 0
cPAE      ta  PAEND
o1PAE     ke  1 0
.         su  cPAE o1PAE BITON
.         so  BITOFF

# ---- 二値を積む ----
#
# 関係の値は compile 時に決まるが、そのまま Cst 一箱で開いて実行時のワイヤにする。
# 開く位置を箱の位置へそろえると、Haskell の descend と箱の並びが一致する
# （19 式 5.1）。compile 時の席のまま持ち回ると、後で開いた位置がずれる。

BITON     ke  742 0
o1BTq      ke  1 0
.         ti  BITON o1BTq
.         so  BITZ

BITOFF    ke  742 0
zBFq       ke  0 0
.         ti  BITOFF zBFq
.         so  BITZ

BITZ      ke  6 0
nBZq       ta  BITZ
oBZKq      sa  KV04 BW
aBZKq      ko  oBZKq nBZq
o1BZq      ke  1 0
.         ti  aBZKq o1BZq                   # 種類 1 = Cst
bBZAq      sa  KV06 BW
aBZAq      ko  bBZAq nBZq
w742BZq    ke  742 0
vBZq       ta  w742BZq
.         ti  aBZAq vBZq                    # 分子 = 二値
dBZDq      sa  KV10 BW
aBZDq      ko  dBZDq nBZq
zBZq       ke  0 0
.         ti  aBZDq zBZq                    # 深度 0
.         so  PSBIT

# ================= 境界 ∂ =================

GRGBD     ke  69 0
t47BD     ke  47 0
.         ti  GRGBD t47BD
.         so  RD1

R1RGD     ke  62 0
kRGD      ta  R1RGD
t34RGD    ke  34 0
.         su  kRGD t34RGD RGBD0
.         so  BAD

RGBD0     ke  712 0
w63BD     ke  63 0
mBD       ta  w63BD
.         ti  RGBD0 mBD
w736BD    ke  736 0
.         ti  w736BD mBD
w713BD    ke  713 0
t2BD      ke  2 0
mBD2      sa  t2BD mBD
.         ti  w713BD mBD2
w720BD    ke  720 0
t6BD      ke  6 0
.         ti  w720BD t6BD
.         so  SETOUT                      # A ∖ 2A = 負側

GBD1      ke  721 0
w714BD1   ke  714 0
rBD1      ta  w714BD1
.         ti  GBD1 rBD1
w712BD2   ke  712 0
w736BD2   ke  736 0
aBD2      ta  w736BD2
t2BD2     ke  2 0
aBD2b     sa  t2BD2 aBD2
.         ti  w712BD2 aBD2b               # RGA = 2A
w713BD2   ke  713 0
.         ti  w713BD2 aBD2                # RGB = A
w720BD2   ke  720 0
t7BD2     ke  7 0
.         ti  w720BD2 t7BD2
.         so  SETOUT                      # 2A ∖ A = 正側

GBD2      ke  722 0
w714BD3   ke  714 0
rBD2      ta  w714BD3
.         ti  GBD2 rBD2
.         so  CHPSH

# ---- 鎖を積む。欄 0 が負側、欄 1 が正側 ----
CHPSH     ke  62 0
k35CH     ke  35 0
.         ti  CHPSH k35CH
w63CH     ke  63 0
w721CH    ke  721 0
nCH       ta  w721CH
.         ti  w63CH nCH
w64CH     ke  64 0
w722CH    ke  722 0
pCH       ta  w722CH
.         ti  w64CH pCH
w65CH     ke  65 0
zCH       ke  0 0
.         ti  w65CH zCH
w66CH     ke  66 0
.         ti  w66CH zCH
w67CH     ke  67 0
.         ti  w67CH zCH
w68CH     ke  68 0
.         ti  w68CH zCH
.         so  PSC

# ================= bi：鎖の境界。∂∂ = 0 =================
#
# 平文から作れる鎖は領域の境界であり、頂点の鎖になる。
# 頂点の境界は空なので、∂∂ = 0 が一箱も置かずに出る（影響関数 証明3.2）。

GBI       ke  69 0
t42BI     ke  42 0
.         ti  GBI t42BI
.         so  RD1

R1CHB     ke  62 0
kCHB      ta  R1CHB
t35CHB    ke  35 0
.         su  kCHB t35CHB CHB1
.         so  BAD
CHB1      ke  721 0
zCHB      ke  0 0
.         ti  CHB1 zCHB
w722CHB   ke  722 0
.         ti  w722CHB zCHB
.         so  CHPSH

# ================= bu：鎖の加算 =================
#
# 係数は {−1, 0, 1} に限られる（影響関数 証明3.2）。四つの mask を
# 指示ベクトルへ広げ、cell ごとに和を取る。|和| が 2 になった平文は
# 鎖を出さないので、失敗を報告する。

GBU       ke  69 0
t43BU     ke  43 0
.         ti  GBU t43BU
.         so  RD1

R1CHA     ke  62 0
kCHA      ta  R1CHA
t35CHA    ke  35 0
.         su  kCHA t35CHA CHA1
.         so  BAD
CHA1      ke  721 0
w63CHA    ke  63 0
n1CHA     ta  w63CHA
.         ti  CHA1 n1CHA
w722CHA   ke  722 0
w64CHA    ke  64 0
p1CHA     ta  w64CHA
.         ti  w722CHA p1CHA
w69CHA    ke  69 0
t44CHA    ke  44 0
.         ti  w69CHA t44CHA
.         so  RD1

R1CHC     ke  62 0
kCHC      ta  R1CHC
t35CHC    ke  35 0
.         su  kCHC t35CHC CHC1
.         so  BAD
CHC1      ke  723 0
w63CHC    ke  63 0
n2CHC     ta  w63CHC
.         ti  CHC1 n2CHC
w724CHC   ke  724 0
w64CHC    ke  64 0
p2CHC     ta  w64CHC
.         ti  w724CHC p2CHC

CHZ       ke  715 0
zCHZ      ke  0 0
.         ti  CHZ zCHZ
ENTCHZ    ke  0 0
LCHZE     ke  715 0
kCHZ      ta  LCHZE
n32CHZ    ke  32 0
.         se  kCHZ n32CHZ LCHZ
.         so  CADD0
LCHZ      ke  680 0
w715CHZ   ke  715 0
kCHZb     ta  w715CHZ
aCHZ      ko  LCHZ kCHZb
zCHZb     ke  0 0
.         ti  aCHZ zCHZb
o1CHZ     ke  1 0
kCHZc     ko  kCHZb o1CHZ
.         ti  w715CHZ kCHZc
CNTCHZ    ke  0 0
LCHZEz    ke  715 0
kCHZz     ta  LCHZEz
n32CHZz   ke  32 0
.         se  kCHZz n32CHZz LCHZ
.         so  CADD0

# 四つの mask を順に足し込む。負側は −1、正側は +1
CADD0     ke  712 0
w721CA    ke  721 0
n1CA      ta  w721CA
.         ti  CADD0 n1CA
w738CA    ke  738 0
o1CA      ke  1 0
nCA       si  o1CA
.         ti  w738CA nCA
w720CA    ke  720 0
