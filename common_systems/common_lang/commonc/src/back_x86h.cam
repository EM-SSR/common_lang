.         ti  aB4 db
w26b      ke  26 0
dc        ta  w26b
bDC4      sa  KV18 BW
aC4       ko  bDC4 j4
.         ti  aC4 dc

# 次の変位。da += 8、繰り上がりは 256 ごと
v8D       ke  8 0
da2       ko  da v8D
c256      ke  256 0
.         se  da2 c256 L4A
n256      si  c256
da3       ko  da2 n256
w24c      ke  24 0
.         ti  w24c da3
w25c      ke  25 0
dbb       ta  w25c
o14       ke  1 0
db2       ko  dbb o14
.         se  db2 c256 L4C
db3       ko  db2 n256
.         ti  w25c db3
w26c      ke  26 0
dcc       ta  w26c
dc2       ko  dcc o14
.         ti  w26c dc2
.         so  L4D

L4C       ke  25 0
.         ti  L4C db2
.         so  L4D

L4A       ke  24 0
.         ti  L4A da2
.         so  L4D

L4D       ke  20 0
j4b       ta  L4D
o14b      ke  1 0
j4c       ko  j4b o14b
.         ti  L4D j4c
# ---- 閉じ。集積境界の内側にいる間は本体へ戻る ----
CNTW5     ke  0 0
L4W5z     ke  20 0
j4W5z     ta  L4W5z
w6DxW5z   ke  6 0
n4DW5z    ta  w6DxW5z
.         se  j4W5z n4DW5z L4
.         so  E4C                        # 境界に届いた

# ================= 第 4b 段：箱ごとの byte 位置 =================
#
# 分岐の変位は byte 位置の差になる。除算が無いので、箱の昇順に桁上げを持ち回る。
# 一命令の長さは 33 を越えないので、桁上げは一段で足りる

