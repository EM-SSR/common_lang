EZ5z      ke  0 0
.         ti  EZ5da EZ5z
EZ5o      ke  1 0
EZ5n2     ko  EZ5n EZ5o
.         ti  EZ50 EZ5n2

# 箱 6 : Neg(gt)
EZ60      ke  6 0
EZ6n      ta  EZ60
