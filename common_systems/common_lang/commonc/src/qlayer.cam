# commonc — 判定層 𝒬 の降下（07 §6、圏論 定理 3.3、3.4）
#
# 前段の第 2 段から呼ばれる。frontier の上では 𝒬 の値を
#
#   種類 4    CV0 = 分子の箱   CV1 = 分母の箱   CV2 = 門の箱
#
# の三本で持つ。構成語は空語 ([], +1) に固定する。名詞層から来る値は
# 語が割れるので、この道では扱わない（来たら Ko で止める）。
#
# ---- 深度 ----
#
# liftQ が Store と Load を通すので、判定層の値は全部深度 0 になる（14 §1）。
# したがってここで置く箱の OPD 欄は常に 0 になる。
#
# ---- 呼び出し ----
#
# cam に手続き呼び出しは無い。どの助けも自分を呼ばないので、戻り符号を
# 助けごとの語へ置けば足りる。積む台は要らない。
#
#   500 ltB の返り      501 ltB の戻り符号
#   502 selB の返り     503 戻り符号     504-506 引数 c x y
#   507 eqZ の返り      508 戻り符号     509 引数 a
#   510-511 normQ の返り  512 戻り符号   513-514 引数
#   515-516 clamp1 の返り 517 戻り符号   518-519 引数
#   520 ltQ の返り        521 戻り符号   522-525 引数
#   526-527 divQ の返り   528 戻り符号   529-532 引数
#   533-534 resB の返り   535 戻り符号   536-539 引数
#   540-541 agrR の返り   542 戻り符号   543-546 引数
#   547-548 agrE の返り   549 戻り符号   550-553 引数
#   554-555 lftQ の返り   556 戻り符号   557 引数
#   560-579 生成元の作業
#   580-589 selectJudge の作業

# ================= ltB の戻り先 =================
#
# 八箱は前段が持つ。戻り符号（語 501）で呼び出し元へ返る

LTBR      ke  501 0
gLT       ta  LTBR
lt1       ke  1 0
.         su  gLT lt1 EZ1R
lt2       ke  2 0
.         su  gLT lt2 EZ2R
lt3       ke  3 0
.         su  gLT lt3 NQ1R
lt4       ke  4 0
.         su  gLT lt4 CL1R
lt5       ke  5 0
.         su  gLT lt5 LQ1R
lt6       ke  6 0
.         su  gLT lt6 QB1R
lt7       ke  7 0
.         su  gLT lt7 QB2R
lt8       ke  8 0
.         su  gLT lt8 QB3R
.         so  BAD

# ================= liftQ：Dyad の語を有理数の対へ持ち上げる =================
#
#   s = Cst(退避語, 0)      Store(s, u)      n = Load(s)      b = Cst(2^d, 0)
#
# Load を通すので n の深度は 0 になる。分母は入力の深度から出る（14 §1.3）

LFQ       ke  557 0
uLF       ta  LFQ

# 箱 A : Cst(31, 0)
LFA0      ke  6 0
LFAn      ta  LFA0
LFAk      sa  KV04 BW
LFAka     ko  LFAk LFAn
LFAkv     ke  1 0
.         ti  LFAka LFAkv
LFAa      sa  KV06 BW
LFAaa     ko  LFAa LFAn
LFAsw     ke  31 0
.         ti  LFAaa LFAsw

# 退避語の箱を控える（22 式 22.3）
SCLw      ke  94 0
SCLc      ta  SCLw
SCLb      sa  KV40 BW
SCLa      ko  SCLb SCLc
.         ti  SCLa LFAn
SCLo      ke  1 0
SCLc2     ko  SCLc SCLo
.         ti  SCLw SCLc2
LFAd      sa  KV10 BW
LFAda     ko  LFAd LFAn
LFAz      ke  0 0
.         ti  LFAda LFAz
LFAo      ke  1 0
LFAn2     ko  LFAn LFAo
.         ti  LFA0 LFAn2

# 箱 B : Store(A, u)
LFB0      ke  6 0
LFBn      ta  LFB0
LFBk      sa  KV04 BW
LFBka     ko  LFBk LFBn
LFBkv     ke  5 0
.         ti  LFBka LFBkv
LFBa      sa  KV06 BW
LFBaa     ko  LFBa LFBn
.         ti  LFBaa LFAn
LFBb      sa  KV08 BW
LFBba     ko  LFBb LFBn
.         ti  LFBba uLF
LFBd      sa  KV10 BW
LFBda     ko  LFBd LFBn
LFBz      ke  0 0
.         ti  LFBda LFBz
LFBo      ke  1 0
LFBn2     ko  LFBn LFBo
.         ti  LFB0 LFBn2

# 箱 C : Load(A)
LFC0      ke  6 0
LFCn      ta  LFC0
LFCk      sa  KV04 BW
LFCka     ko  LFCk LFCn
LFCkv     ke  7 0
.         ti  LFCka LFCkv
LFCa      sa  KV06 BW
LFCaa     ko  LFCa LFCn
.         ti  LFCaa LFAn
LFCd      sa  KV10 BW
LFCda     ko  LFCd LFCn
LFCz      ke  0 0
.         ti  LFCda LFCz
LFCo      ke  1 0
LFCn2     ko  LFCn LFCo
.         ti  LFC0 LFCn2

# 2^d を作る。除算も冪も無いので、入力の深度の回数だけ倍にする
LFP0      ke  560 0
LFP1      ke  1 0
.         ti  LFP0 LFP1
LFP2      ke  561 0
LFPd      sa  KV10 BW
LFPda     ko  LFPd uLF
LFPdv     ta  LFPda
.         ti  LFP2 LFPdv

LFPE      ke  561 0
LFPk      ta  LFPE
LFPz      ke  0 0
.         se  LFPz LFPk LFPL
.         so  LFD

LFPL      ke  560 0
LFPv      ta  LFPL
LFPv2     ko  LFPv LFPv
.         ti  LFPL LFPv2
LFPE2     ke  561 0
LFPk2     ta  LFPE2
LFPm      ke  -1 0
LFPk3     ko  LFPk2 LFPm
.         ti  LFPE2 LFPk3
LFPz2     ke  0 0
.         se  LFPz2 LFPk3 LFPL
.         so  LFD

# 箱 D : Cst(2^d, 0)
LFD       ke  6 0
LFDn      ta  LFD
LFDk      sa  KV04 BW
LFDka     ko  LFDk LFDn
LFDkv     ke  1 0
.         ti  LFDka LFDkv
LFDa      sa  KV06 BW
LFDaa     ko  LFDa LFDn
LFDw      ke  560 0
LFDpw     ta  LFDw
.         ti  LFDaa LFDpw
LFDd      sa  KV10 BW
LFDda     ko  LFDd LFDn
LFDz      ke  0 0
.         ti  LFDda LFDz
LFDo      ke  1 0
LFDn2     ko  LFDn LFDo
.         ti  LFD LFDn2

# 返り
LFR0      ke  554 0
.         ti  LFR0 LFCn
LFR1      ke  555 0
.         ti  LFR1 LFDn
LFR2      ke  556 0
gLF       ta  LFR2
lf1       ke  1 0
.         su  gLF lf1 LF1R
lf2       ke  2 0
.         su  gLF lf2 LF2R
lf3       ke  3 0
.         su  gLF lf3 LF3R
lf4       ke  4 0
.         su  gLF lf4 LF4R
lf5       ke  5 0
.         su  gLF lf5 LF5R
lf6       ke  6 0
.         su  gLF lf6 LF6R
.         so  BAD

# ================= selB：選択は算術になる（16 式 5.11）=================
#
#   sel(c, x, y) = c ⋆ x ⊕ (1 ⊖ c) ⋆ y
#
#   t1 = Mul(c,x)   o = Cst(1,0)   nc = Neg(c)   ic = Add(o,nc)
#   t2 = Mul(ic,y)  r = Add(t1,t2)

SLB       ke  504 0
cSL       ta  SLB
SLBx      ke  505 0
xSL       ta  SLBx
SLBy      ke  506 0
ySL       ta  SLBy

# 箱 1 : Mul(c, x)
SL10      ke  6 0
SL1n      ta  SL10
SL1k      sa  KV04 BW
SL1ka     ko  SL1k SL1n
SL1kv     ke  3 0
.         ti  SL1ka SL1kv
SL1a      sa  KV06 BW
SL1aa     ko  SL1a SL1n
.         ti  SL1aa cSL
SL1b      sa  KV08 BW
SL1ba     ko  SL1b SL1n
.         ti  SL1ba xSL
SL1d      sa  KV10 BW
SL1da     ko  SL1d SL1n
SL1z      ke  0 0
.         ti  SL1da SL1z
SL1o      ke  1 0
SL1n2     ko  SL1n SL1o
.         ti  SL10 SL1n2

# 箱 2 : Cst(1, 0)
SL20      ke  6 0
SL2n      ta  SL20
SL2k      sa  KV04 BW
SL2ka     ko  SL2k SL2n
SL2kv     ke  1 0
.         ti  SL2ka SL2kv
SL2a      sa  KV06 BW
SL2aa     ko  SL2a SL2n
SL2one    ke  1 0
.         ti  SL2aa SL2one
SL2d      sa  KV10 BW
SL2da     ko  SL2d SL2n
SL2z      ke  0 0
.         ti  SL2da SL2z
SL2o      ke  1 0
SL2n2     ko  SL2n SL2o
.         ti  SL20 SL2n2

# 箱 3 : Neg(c)
SL30      ke  6 0
SL3n      ta  SL30
SL3k      sa  KV04 BW
SL3ka     ko  SL3k SL3n
SL3kv     ke  4 0
.         ti  SL3ka SL3kv
SL3a      sa  KV06 BW
SL3aa     ko  SL3a SL3n
.         ti  SL3aa cSL
SL3d      sa  KV10 BW
SL3da     ko  SL3d SL3n
SL3z      ke  0 0
.         ti  SL3da SL3z
SL3o      ke  1 0
SL3n2     ko  SL3n SL3o
.         ti  SL30 SL3n2

# 箱 4 : Add(o, nc)
SL40      ke  6 0
SL4n      ta  SL40
SL4k      sa  KV04 BW
SL4ka     ko  SL4k SL4n
SL4kv     ke  2 0
.         ti  SL4ka SL4kv
SL4a      sa  KV06 BW
SL4aa     ko  SL4a SL4n
.         ti  SL4aa SL2n
SL4b      sa  KV08 BW
SL4ba     ko  SL4b SL4n
.         ti  SL4ba SL3n
SL4d      sa  KV10 BW
SL4da     ko  SL4d SL4n
SL4z      ke  0 0
.         ti  SL4da SL4z
SL4o      ke  1 0
SL4n2     ko  SL4n SL4o
.         ti  SL40 SL4n2

# 箱 5 : Mul(ic, y)
SL50      ke  6 0
SL5n      ta  SL50
SL5k      sa  KV04 BW
SL5ka     ko  SL5k SL5n
SL5kv     ke  3 0
.         ti  SL5ka SL5kv
SL5a      sa  KV06 BW
SL5aa     ko  SL5a SL5n
.         ti  SL5aa SL4n
SL5b      sa  KV08 BW
SL5ba     ko  SL5b SL5n
.         ti  SL5ba ySL
SL5d      sa  KV10 BW
SL5da     ko  SL5d SL5n
SL5z      ke  0 0
.         ti  SL5da SL5z
SL5o      ke  1 0
SL5n2     ko  SL5n SL5o
.         ti  SL50 SL5n2

# 箱 6 : Add(t1, t2)
SL60      ke  6 0
SL6n      ta  SL60
SL6k      sa  KV04 BW
SL6ka     ko  SL6k SL6n
SL6kv     ke  2 0
.         ti  SL6ka SL6kv
SL6a      sa  KV06 BW
SL6aa     ko  SL6a SL6n
.         ti  SL6aa SL1n
SL6b      sa  KV08 BW
SL6ba     ko  SL6b SL6n
.         ti  SL6ba SL5n
SL6d      sa  KV10 BW
SL6da     ko  SL6d SL6n
SL6z      ke  0 0
.         ti  SL6da SL6z
SL6o      ke  1 0
SL6n2     ko  SL6n SL6o
.         ti  SL60 SL6n2

# 返り
SLR0      ke  502 0
.         ti  SLR0 SL6n
SLR1      ke  503 0
gSL       ta  SLR1
sl1       ke  1 0
.         su  gSL sl1 NQ2R
sl2       ke  2 0
.         su  gSL sl2 NQ3R
sl3       ke  3 0
.         su  gSL sl3 CL2R
sl4       ke  4 0
.         su  gSL sl4 CL3R
sl5       ke  5 0
.         su  gSL sl5 RB4R
sl6       ke  6 0
.         su  gSL sl6 RB5R
sl7       ke  7 0
.         su  gSL sl7 AR5R
sl8       ke  8 0
.         su  gSL sl8 AR6R
sl9       ke  9 0
.         su  gSL sl9 AR7R
sl10      ke  10 0
.         su  gSL sl10 SJ4R
sl11      ke  11 0
.         su  gSL sl11 SJ5R
.         so  BAD

# ================= eqZ：[a = 0] = 1 − [a < 0] − [0 < a] =================

EQZ       ke  509 0
aEZ       ta  EQZ

# 箱 1 : Cst(0, 0)
EZ10      ke  6 0
EZ1n      ta  EZ10
EZ1k      sa  KV04 BW
EZ1ka     ko  EZ1k EZ1n
EZ1kv     ke  1 0
.         ti  EZ1ka EZ1kv
EZ1a      sa  KV06 BW
EZ1aa     ko  EZ1a EZ1n
EZ1z0     ke  0 0
.         ti  EZ1aa EZ1z0
EZ1d      sa  KV10 BW
EZ1da     ko  EZ1d EZ1n
.         ti  EZ1da EZ1z0
EZ1o      ke  1 0
EZ1n2     ko  EZ1n EZ1o
.         ti  EZ10 EZ1n2
EZ1S      ke  562 0
.         ti  EZ1S EZ1n

# lt = [a < 0]
EZ1C      ke  48 0
.         ti  EZ1C aEZ
EZ1D      ke  49 0
.         ti  EZ1D EZ1n
EZ1E      ke  50 0
EZ1F      ke  1 0
.         ti  EZ1E EZ1F
EZ1G      ke  501 0
.         ti  EZ1G EZ1F
.         so  BIT

EZ1R      ke  500 0
EZ1H      ta  EZ1R
EZ1I      ke  563 0
.         ti  EZ1I EZ1H

# gt = [0 < a]
EZ2C      ke  48 0
EZ2S      ke  562 0
