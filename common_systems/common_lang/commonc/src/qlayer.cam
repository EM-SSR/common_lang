.         ti  EZ70 EZ7n2

# 箱 8 : Add(t, −gt)
EZ80      ke  6 0
EZ8n      ta  EZ80
EZ8k      sa  KV04 BW
EZ8ka     ko  EZ8k EZ8n
EZ8kv     ke  2 0
.         ti  EZ8ka EZ8kv
EZ8a      sa  KV06 BW
