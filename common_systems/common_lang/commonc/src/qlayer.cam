# ================= ba：除算。Dyad 二本 → 有理数（01 §6）=================
#
# 二進比へ正規化できる商は Cst が直接持つが、runtime 値どうしの商は
# この atlas で実現できない。だから有理数の型を出口に置く。
#
#   (a, b) を持ち上げ、a ⊘ b を正の分母で置く。分母が零なら Ko で止める

GBA       ke  0 0
BA1r      ke  5 0
BA1rw     ke  571 0
.         ti  BA1rw BA1r
.         so  RD0

D05R      ke  570 0
D05Rv     ta  D05R

BA2r      ke  6 0
BA2rw     ke  571 0
.         ti  BA2rw BA2r
.         so  RD0

D06R      ke  570 0
D06Rv     ta  D06R

BAl1g0    ke  557 0
.         ti  BAl1g0 D05Rv
BAl1r     ke  5 0
BAl1rw    ke  556 0
.         ti  BAl1rw BAl1r
.         so  LFQ

LF5R      ke  554 0
LF5Rv     ta  LF5R
LF5Rb     ke  555 0
LF5Rbv    ta  LF5Rb

BAl2g0    ke  557 0
.         ti  BAl2g0 D06Rv
BAl2r     ke  6 0
BAl2rw    ke  556 0
.         ti  BAl2rw BAl2r
.         so  LFQ

LF6R      ke  554 0
LF6Rv     ta  LF6R
LF6Rb     ke  555 0
LF6Rbv    ta  LF6Rb

# divQ(an = 割る側, c = 割られる側) が c ⊘ a を返す
BAdg0     ke  529 0
.         ti  BAdg0 LF6Rv
BAdg1     ke  530 0
.         ti  BAdg1 LF6Rbv
BAdg2     ke  531 0
.         ti  BAdg2 LF5Rv
BAdg3     ke  532 0
.         ti  BAdg3 LF5Rbv
BAdr      ke  3 0
BAdrw     ke  528 0
.         ti  BAdrw BAdr
.         so  DVQ

DQ3R      ke  526 0
DQ3Rv     ta  DQ3R
DQ3Rb     ke  527 0
DQ3Rbv    ta  DQ3Rb

# 分母が零なら止める。二本の分離のどちらも通らなければ Ko へ落ちる
# 零
BAz0      ke  6 0
BAzn      ta  BAz0
BAzk      sa  KV04 BW
BAzka     ko  BAzk BAzn
BAzkv     ke  1 0
.         ti  BAzka BAzkv
BAza      sa  KV06 BW
BAzaa     ko  BAza BAzn
BAzv      ke  0 0
.         ti  BAzaa BAzv
BAzd      sa  KV10 BW
BAzda     ko  BAzd BAzn
BAzz      ke  0 0
.         ti  BAzda BAzz
BAzo      ke  1 0
BAzn2     ko  BAzn BAzo
.         ti  BAz0 BAzn2

# 分離の行き先は Ko の次の箱になる
BAsk      ke  6 0
BAskn     ta  BAsk
BAsk3     ke  3 0
BAskv     ko  BAskn BAsk3

# 零 < 分母なら飛ぶ
BAe10     ke  6 0
BAe1n     ta  BAe10
BAe1k     sa  KV04 BW
BAe1ka    ko  BAe1k BAe1n
BAe1kv    ke  9 0
.         ti  BAe1ka BAe1kv
BAe1a     sa  KV06 BW
BAe1aa    ko  BAe1a BAe1n
.         ti  BAe1aa BAzn
BAe1b     sa  KV08 BW
BAe1ba    ko  BAe1b BAe1n
.         ti  BAe1ba LF6Rv
BAe1l     sa  KV12 BW
BAe1la    ko  BAe1l BAe1n
.         ti  BAe1la BAskv
BAe1d     sa  KV10 BW
BAe1da    ko  BAe1d BAe1n
BAe1z     ke  0 0
.         ti  BAe1da BAe1z
BAe1o     ke  1 0
BAe1n2    ko  BAe1n BAe1o
.         ti  BAe10 BAe1n2

# 分母 < 零なら飛ぶ
BAe20     ke  6 0
BAe2n     ta  BAe20
BAe2k     sa  KV04 BW
BAe2ka    ko  BAe2k BAe2n
BAe2kv    ke  9 0
.         ti  BAe2ka BAe2kv
BAe2a     sa  KV06 BW
BAe2aa    ko  BAe2a BAe2n
.         ti  BAe2aa LF6Rv
BAe2b     sa  KV08 BW
BAe2ba    ko  BAe2b BAe2n
.         ti  BAe2ba BAzn
BAe2l     sa  KV12 BW
BAe2la    ko  BAe2l BAe2n
.         ti  BAe2la BAskv
BAe2d     sa  KV10 BW
BAe2da    ko  BAe2d BAe2n
BAe2z     ke  0 0
.         ti  BAe2da BAe2z
BAe2o     ke  1 0
BAe2n2    ko  BAe2n BAe2o
.         ti  BAe20 BAe2n2

# 零で割った。失敗を報告する
BAko0     ke  6 0
BAkon     ta  BAko0
BAkok     sa  KV04 BW
BAkoka    ko  BAkok BAkon
BAkokv    ke  10 0
.         ti  BAkoka BAkokv
BAkod     sa  KV10 BW
BAkoda    ko  BAkod BAkon
BAkoz     ke  0 0
.         ti  BAkoda BAkoz
BAkoo     ke  1 0
BAkon2    ko  BAkon BAkoo
.         ti  BAko0 BAkon2

# 出口 frontier へ有理数を積む。種類 6
BAk       ke  62 0
BAk6      ke  6 0
.         ti  BAk BAk6
BAr0      ke  63 0
.         ti  BAr0 DQ3Rv
BAr1      ke  64 0
.         ti  BAr1 DQ3Rbv
.         so  PSC

# ================= 有理数を二語へ開く =================
#
# 分子も分母も既に箱なので、控えるだけになる

RMAT      sa  KV28 BW
RMAa      ko  RMAT idCV
RMAn      ta  RMAa
RMAb      sa  KV30 BW
RMAba     ko  RMAb idCV
RMAd      ta  RMAba

RM0w      ke  61 0
RM0wv     ta  RM0w
RM0b      sa  KV03 BW
RM0ba     ko  RM0b RM0wv
.         ti  RM0ba RMAn
RM0i      ke  1 0
RM0o2     ko  RM0wv RM0i
RM0ww     ke  61 0
.         ti  RM0ww RM0o2

RM1w      ke  61 0
RM1wv     ta  RM1w
RM1b      sa  KV03 BW
RM1ba     ko  RM1b RM1wv
.         ti  RM1ba RMAd
RM1i      ke  1 0
RM1o2     ko  RM1wv RM1i
RM1ww     ke  61 0
.         ti  RM1ww RM1o2

.         so  L3NX

