EZ40      ke  6 0
EZ4n      ta  EZ40
EZ4k      sa  KV04 BW
EZ4ka     ko  EZ4k EZ4n
EZ4kv     ke  1 0
.         ti  EZ4ka EZ4kv
EZ4a      sa  KV06 BW
EZ4aa     ko  EZ4a EZ4n
EZ4one    ke  1 0
.         ti  EZ4aa EZ4one
EZ4d      sa  KV10 BW
EZ4da     ko  EZ4d EZ4n
EZ4z      ke  0 0
.         ti  EZ4da EZ4z
EZ4o      ke  1 0
EZ4n2     ko  EZ4n EZ4o
.         ti  EZ40 EZ4n2

# 箱 5 : Neg(lt)
EZ50      ke  6 0
EZ5n      ta  EZ50
