.         ti  QXTWOd QXTWOG
QXTWOe    ke  1060 0
QXTWOf    ke  2 0
.         ti  QXTWOe QXTWOf
.         so  QSPRE

# ---- 測定、リセット。作図が境界の表と箱を置く（qstate.cam の QSSX）----
QXG84     ke  1060 0
QXG84a    ke  3 0
.         ti  QXG84 QXG84a
.         so  QSPRE

QXG85     ke  1060 0
QXG85a    ke  4 0
.         ti  QXG85 QXG85a
.         so  QSPRE

# ---- 移送。作図が写像を更新した後、二本のワイヤを取る箱（種類 15）を置く ----
QXG86     ke  52 0
QXG86n    ke  2 0
.         ti  QXG86 QXG86n
QXG86k    ke  53 0
QXG86v    ke  15 0
.         ti  QXG86k QXG86v
QXG86p    ke  54 0
