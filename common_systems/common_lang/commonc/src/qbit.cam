.         ti  QXp90 QXq90
QXd90      ke  55 0
QXe90      ke  0 0
.         ti  QXd90 QXe90
.         so  QSSAV

# ---- kukeyi：名詞 → 量子ビットの番号 ----
#
# 入口 frontier の名詞（compile 時の値）を RD1 で読み、cell = 2 zz(m) + ε を定数の箱として積む。
# 戻り符号は語 69 = 50。zz(m) は m >= 0 で 2m、m < 0 で −2m−1（region.cam の kukeke と同じ式）。
# 作業語 790 に zz を置く。

QXG91     ke  69 0
QXn91      ke  50 0
.         ti  QXG91 QXn91
.         so  RD1

QXN1      ke  62 0
QXNa      ta  QXN1
