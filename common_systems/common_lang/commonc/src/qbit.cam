# commonc 量子層 — Counter 量子情報論の量子の語（lane-qbit だけが受ける）
# doc: casm.lane64.isa casm.lane64.layer chamber.def
#
# 三音節の名前 ku + [σ_3, σ_b] のうち、g = 63 + (b − 3) = 72 以降を量子の語に割り当てる。
# region.cam の最後の分岐が GKUQ へ来る。どの語も、compile 時の作図（qstate.cam）を通してから箱を置く。
# 量子ビットの番号と、角・割合・倍率は frontier の定数の箱（Cst）でなければならない。
#
# ---- 語の一覧（g、名前、ワイヤ、作図）----
#   72〜80  kuketu kukete kuketo kukena kukeni kukenu kukene kukeno kukeha
#           h x y z s sdg t tdg sx。ワイヤは量子ビット
#   81〜83  kukehi kukehu kukehe   cx cz swap。ワイヤは二つの量子ビット（位置 0 が制御）
#   84      kukeho  測定。ワイヤは量子ビット、出力は結果 x。境界の表を置き、枝を分ける（論文 3.6、3.7）
#   85      kukema  リセット。候補（語 1061）が「u を使う」なら、測定と同じく枝を分けて子 1 に X
#   86      kukemi  移送 B_x。ワイヤは量子ビットと x（論文 6.2）
#   87〜89  kukemu kukeme kukemo   rx ry rz。ワイヤは量子ビットと角の番号（host の角の表）
#   90      kukeya  状態の保存。ワイヤは種類。全部の枝の状態を host へ書き出す
#   91      kukeyi  量子ビットの名詞。名詞ノードの cell 番号 2·zz(m) + ε を定数の箱にする
#   92      kukeyu  メビウス作用 u → f u/(1 − u + f u)。ワイヤは fn、fd（論文 16.5）
#   93      kukeye  β。作図深度を一つ進める（論文 13.1）
#   94      kukeyo  次の移送の割合 ε = en/ed（論文 15.11）
#   95、97  kukera kukeru   古典ビットを読む、書く
#   96、98〜101            条件、delay、多量子ビットの表、状態の設定は作図がまだ無い（BAD か記録だけ）
#
# 箱の種類（後段 back_lane_qbit.cam が命令へ落とす）
#   12 ゲート（OPD にゲートの番号 0〜14）  13 測定  14 リセット  15 移送  18 保存  19 メビウス  20 β  21 割合
#   測定とリセットの箱の第二のワイヤは、境界の表の基底の定数の箱

GKUQ      ke  72 0
.         su  gKU GKUQ QXG72
QXc73      ke  73 0
.         su  gKU QXc73 QXG73
QXc74      ke  74 0
.         su  gKU QXc74 QXG74
QXc75      ke  75 0
.         su  gKU QXc75 QXG75
QXc76      ke  76 0
.         su  gKU QXc76 QXG76
QXc77      ke  77 0
.         su  gKU QXc77 QXG77
QXc78      ke  78 0
.         su  gKU QXc78 QXG78
QXc79      ke  79 0
.         su  gKU QXc79 QXG79
QXc80      ke  80 0
.         su  gKU QXc80 QXG80
QXc81      ke  81 0
.         su  gKU QXc81 QXG81
QXc82      ke  82 0
.         su  gKU QXc82 QXG82
QXc83      ke  83 0
.         su  gKU QXc83 QXG83
QXc84      ke  84 0
.         su  gKU QXc84 QXG84
QXc85      ke  85 0
.         su  gKU QXc85 QXG85
QXc86      ke  86 0
.         su  gKU QXc86 QXG86
QXc87      ke  87 0
.         su  gKU QXc87 QXG87
QXc88      ke  88 0
.         su  gKU QXc88 QXG88
QXc89      ke  89 0
.         su  gKU QXc89 QXG89
QXc90      ke  90 0
.         su  gKU QXc90 QXG90
QXc91      ke  91 0
.         su  gKU QXc91 QXG91
QXc92      ke  92 0
.         su  gKU QXc92 QXG92
QXc93      ke  93 0
.         su  gKU QXc93 QXG93
QXc94      ke  94 0
.         su  gKU QXc94 QXG94
QXc95      ke  95 0
.         su  gKU QXc95 QXG95
QXc96      ke  96 0
.         su  gKU QXc96 QXG96
QXc97      ke  97 0
.         su  gKU QXc97 QXG97
QXc98      ke  98 0
.         su  gKU QXc98 QXG98
QXc99      ke  99 0
