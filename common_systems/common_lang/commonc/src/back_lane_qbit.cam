# ================= 算術：Add / Mul / Neg =================
#
#   命令 4  ADD/MUL/NEG a=1 b=1 c=2
#   命令 5  MAT 3, 64+j
#   命令 6  ST  3, 1

LNA4      ke  265 0
LNA4a     ke  1 0
.         ti  LNA4 LNA4a
LNA4b     ke  266 0
LNA4c     ke  1 0
.         ti  LNA4b LNA4c

LNA4d     ke  3 0
.         su  LNZU LNA4d LNAMU
LNA4e     ke  4 0
.         su  LNZU LNA4e LNANE
QXI13     ke  13 0
.         su  LNZU QXI13 QXFP
QXI22     ke  22 0
.         su  LNZU QXI22 QXFL

# Add。深度をそろえる左シフトが入る（core/01 式 4.3）
LNA4f     ke  264 0
LNA4g     ke  2 0
.         ti  LNA4f LNA4g
LNA4h     ke  267 0
LNA4i     ke  2 0
.         ti  LNA4h LNA4i
.         so  LNSH

LNAMU     ke  264 0
LNAMUa    ke  3 0
.         ti  LNAMU LNAMUa
LNAMUb    ke  267 0
