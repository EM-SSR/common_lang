.         ti  LNAMUb LNAMUc
.         so  LNAOU

LNANE     ke  264 0
LNANEa    ke  4 0
.         ti  LNANE LNANEa
.         so  LNAOU

# ---- 左シフト量。s_u = d(w) − d(u)、s_v = d(w) − d(v)（19 式 4.3）----
LNSH      ke  20 0
LNSHa     ta  LNSH
LNSHb     sa  KV10 BW
LNSHc     ko  LNSHb LNSHa
LNSHd     ta  LNSHc
LNSHe     ke  104 0
LNSHf     ta  LNSHe
LNSHg     sa  KV10 BW
LNSHh     ko  LNSHg LNSHf
LNSHi     ta  LNSHh
LNSHj     si  LNSHi
LNSHk     ko  LNSHd LNSHj
LNSHl     ke  256 0
.         se  LNSHk LNSHl LNSHm
.         so  BAD
LNSHm     ke  268 0
.         ti  LNSHm LNSHk
LNSHn     ke  105 0
LNSHo     ta  LNSHn
