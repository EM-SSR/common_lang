.         ti  LNI3d LNI3e

LNI3f     ke  5 0
.         su  LNZU LNI3f LNFST
LNI3g     ke  8 0
.         su  LNZU LNI3g LNFBR
LNI3h     ke  9 0
.         su  LNZU LNI3h LNFBR
QXI12     ke  12 0
.         su  LNZU QXI12 QXFG
QXI14     ke  14 0
.         su  LNZU QXI14 QXFK
QXI15     ke  15 0
