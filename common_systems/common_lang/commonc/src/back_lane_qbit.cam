# commonc 後段 — 疑似命令列を lane-qbit の image へ落とす
#
# back_lane64.cam に量子の三命令を足したもの。足した箇所は QX の印で探せる。
#   種類 12  ゲート    ST と同じ形で QG（op 13）。imm = ゲート番号（OPD 欄）
#   種類 13  測定      ADD と同じ形で QM（op 14）。a = 出力 x、b = 量子ビット
#   種類 14  リセット  ST と同じ形で QR（op 15）。b = 量子ビット
#   種類 15  移送      ST と同じ形で QT（op 16）。b = 量子ビット、c = 結果 x
#   種類 16  表の選択  ST と同じ形で QS（op 17）。b = 表の番号
#   種類 17  表のゲート ST と同じ形で QA（op 18）。b = 第一の量子ビット、c = 第二の量子ビット
#   種類 18  状態の保存 ST と同じ形で QV（op 19）。オペランドは使わない
#   種類 19  読み出し  ST と同じ形で QJ（op 20）。b = k（Π_i の回転 i^k）
#   種類 20  β         ST と同じ形で QB（op 21）。オペランドは使わない
#   種類 21  割合      ST と同じ形で QE（op 22）。b = 分子、c = 分母
#   種類 22  記録      ADD と同じ形で QL（op 23）。a = 出力、b = m
#
#
# 仕様は docs/common-compiler/arch/20。前段が置いた OPK / OPA / OPB / OPD / OPL と
# 刻み BW を読み、IMG 26B へ byte を積む。
#
# ---- x86-64 hosted 版との違いは三つ ----
#
#   1. 命令語が固定 16 byte になる（20 式 2.1）。prologue も epilogue も無い
#   2. pc が byte でなく命令の番号を数える（20 式 2.2）。分岐の変位も命令の本数になる
#   3. 語が多倍長なので、中間値の幅で場合分けが起きない（20 §0.3、命題 4.1）
#
# ---- 命令語の欄（20 §2）----
#
#   byte 0     op
#   byte 1     a    出力 landmark
#   byte 2     b    第一入力
#   byte 3     c    第二入力
#   byte 4-5   s_b  b の左シフト
#   byte 6-7   s_c  c の左シフト
#   byte 8-15  imm  分子、または分岐の変位
#
#   op: 0 HALT  1 MAT  2 ADD  3 MUL  4 NEG  5 EQ  6 LT  7 JMP
#       8 LD    9 ST  10 OK  11 KO  12 PUT
#
# ---- 覆い ----
#
#   19 式 (6.1) と同じ λ(w) = 語 64+w を採る。landmark は三本だけ使う。
#
#   R1  第一の値      R2  第二の値      R3  番地
#
#   干渉グラフも生存区間も要らない。代償は語の往復で、一つの疑似命令が
#   最大 7 命令へ開く。
#
# ---- 疑似命令ごとの命令の本数 ----
#
#   1 Cst 3   2 Add 7   3 Mul 7   4 Neg 7   5 Store 5
#   6 Ok  1   7 Load 5  8 EqBr 5  9 LtBr 5
#
# ---- 語の割付（前段の 0..58 に続く）----
#
#   100  nins   この箱が出す命令の本数
#   101  総 byte 数
#   102  emit の走査位置
#   103  雛形を零で埋める走査位置
#   104  u   第一入力のワイヤ
#   105  v   第二入力のワイヤ
#   106  su  左シフト a
#   107  sv  左シフト b
#   108  fill 変位の上位 byte。負なら 255
#   110-112  64+u の byte
#   113-115  64+v の byte
#   116-118  64+j の byte
#   120-122  分岐の変位の byte
#   200-311  組み立て中の命令語。16 語 × 7 命令
#
# ---- 配列（前段と共有）----
#
#   DA 14B  DB 16B  DC 18B   語番号 64+w の byte 0,1,2
#   BA 20B  BB 22B  BC 24B   箱の先頭命令の番号の byte 0,1,2
#   IMG 42B                  image の byte
#
# 箱あたり最大 112 byte なので、本文の基底は 288B 以上を要る。

# ================= 第 4 段：語番号の byte 分解 =================
#
# word(w) = 64 + w。除算が無いので、w の昇順に桁上げを持ち回る。
# 走りは語 24 25 26 に置く

LNP0      ke  24 0
LNP1      ke  64 0
.         ti  LNP0 LNP1
LNP2      ke  25 0
LNPZ      ke  0 0
.         ti  LNP2 LNPZ
LNP3      ke  26 0
.         ti  LNP3 LNPZ
LNP4      ke  20 0
.         ti  LNP4 LNPZ

# ---- 入口。0 回のときは本体へ入らない ----
LNP5      ke  20 0
LNP6      ta  LNP5
LNP7      ke  6 0
LNP8      ta  LNP7
.         se  LNP6 LNP8 LNW4
.         so  LNQ0

LNW4      ke  20 0
LNW4A     ta  LNW4

LNW4B     ke  24 0
LNW4C     ta  LNW4B
LNW4D     sa  KV14 BW
LNW4E     ko  LNW4D LNW4A
.         ti  LNW4E LNW4C

LNW4F     ke  25 0
LNW4G     ta  LNW4F
LNW4H     sa  KV16 BW
LNW4I     ko  LNW4H LNW4A
.         ti  LNW4I LNW4G

LNW4J     ke  26 0
LNW4K     ta  LNW4J
LNW4L     sa  KV18 BW
LNW4M     ko  LNW4L LNW4A
.         ti  LNW4M LNW4K

# 次の語番号。da += 1、繰り上がりは 256 ごと
LNW4N     ke  1 0
LNW4O     ko  LNW4C LNW4N
LNW4P     ke  256 0
.         se  LNW4O LNW4P LNW4X
LNW4Q     si  LNW4P
LNW4R     ko  LNW4O LNW4Q
LNW4S     ke  24 0
.         ti  LNW4S LNW4R
LNW4T     ke  25 0
LNW4U     ta  LNW4T
LNW4V     ke  1 0
LNW4W     ko  LNW4U LNW4V
LNW4Y     ke  256 0
.         se  LNW4W LNW4Y LNW4Z
LNW4a     si  LNW4Y
LNW4b     ko  LNW4W LNW4a
LNW4c     ke  25 0
.         ti  LNW4c LNW4b
LNW4d     ke  26 0
LNW4e     ta  LNW4d
LNW4f     ke  1 0
LNW4g     ko  LNW4e LNW4f
.         ti  LNW4d LNW4g
.         so  LNW4h

LNW4Z     ke  25 0
.         ti  LNW4Z LNW4W
.         so  LNW4h

LNW4X     ke  24 0
.         ti  LNW4X LNW4O
.         so  LNW4h

LNW4h     ke  20 0
LNW4i     ta  LNW4h
LNW4j     ke  1 0
LNW4k     ko  LNW4i LNW4j
.         ti  LNW4h LNW4k

# ---- 閉じ ----
LNW4l     ke  20 0
LNW4m     ta  LNW4l
LNW4n     ke  6 0
LNW4o     ta  LNW4n
.         se  LNW4m LNW4o LNW4
.         so  LNQ0

# ================= 第 4b 段：箱ごとの命令番号 =================
#
# 分岐の変位は命令番号の差になる。箱の昇順に本数を足していく。
# prologue が無いので走りは 0 から始まる

LNQ0      ke  24 0
LNQZ      ke  0 0
.         ti  LNQ0 LNQZ
LNQ1      ke  25 0
.         ti  LNQ1 LNQZ
LNQ2      ke  26 0
.         ti  LNQ2 LNQZ
LNQ3      ke  20 0
.         ti  LNQ3 LNQZ

# ---- 入口 ----
LNQ4      ke  20 0
LNQ5      ta  LNQ4
LNQ6      ke  6 0
LNQ7      ta  LNQ6
.         se  LNQ5 LNQ7 LNW5
.         so  LNR0

LNW5      ke  20 0
LNW5A     ta  LNW5

LNW5B     ke  24 0
LNW5C     ta  LNW5B
LNW5D     sa  KV20 BW
LNW5E     ko  LNW5D LNW5A
.         ti  LNW5E LNW5C

LNW5F     ke  25 0
LNW5G     ta  LNW5F
LNW5H     sa  KV22 BW
LNW5I     ko  LNW5H LNW5A
.         ti  LNW5I LNW5G

LNW5J     ke  26 0
LNW5K     ta  LNW5J
LNW5L     sa  KV24 BW
LNW5M     ko  LNW5L LNW5A
.         ti  LNW5M LNW5K

# 種類ごとの本数を語 100 へ置く
LNW5N     sa  KV04 BW
LNW5O     ko  LNW5N LNW5A
LNW5P     ta  LNW5O
LNW5Q     ke  1 0
.         su  LNW5P LNW5Q LNN3
LNW5R     ke  5 0
.         su  LNW5P LNW5R LNN5
LNW5S     ke  6 0
.         su  LNW5P LNW5S LNN1
LNW5T     ke  7 0
.         su  LNW5P LNW5T LNN5
LNW5U     ke  8 0
.         su  LNW5P LNW5U LNN5
LNW5V     ke  9 0
.         su  LNW5P LNW5V LNN5
LNW5W     ke  10 0
.         su  LNW5P LNW5W LNN1
LNW5X     ke  11 0
.         su  LNW5P LNW5X LNN3
# QX 種類 12、14 は 5 本、13 は 7 本
QXW12     ke  12 0
.         su  LNW5P QXW12 LNN5
QXW13     ke  13 0
.         su  LNW5P QXW13 LNN7
QXW14     ke  14 0
.         su  LNW5P QXW14 LNN5
QXW15     ke  15 0
.         su  LNW5P QXW15 LNN5
QXW16     ke  16 0
.         su  LNW5P QXW16 LNN5
QXW17     ke  17 0
.         su  LNW5P QXW17 LNN5
QXW18     ke  18 0
.         su  LNW5P QXW18 LNN5
QXW19     ke  19 0
.         su  LNW5P QXW19 LNN5
QXW20     ke  20 0
.         su  LNW5P QXW20 LNN5
QXW21     ke  21 0
.         su  LNW5P QXW21 LNN5
QXW22     ke  22 0
.         su  LNW5P QXW22 LNN7
QXW23     ke  23 0
.         su  LNW5P QXW23 LNN5
QXW24     ke  24 0
.         su  LNW5P QXW24 LNN5
QXW25     ke  25 0
.         su  LNW5P QXW25 LNN5
QXW26     ke  26 0
.         su  LNW5P QXW26 LNN5
QXW27     ke  27 0
.         su  LNW5P QXW27 LNN5
QXW28     ke  28 0
.         su  LNW5P QXW28 LNN5
.         so  LNN7

LNN1      ke  1 0
LNN1A     ke  100 0
.         ti  LNN1A LNN1
.         so  LNNA

LNN3      ke  3 0
LNN3A     ke  100 0
.         ti  LNN3A LNN3
.         so  LNNA

LNN5      ke  5 0
LNN5A     ke  100 0
.         ti  LNN5A LNN5
.         so  LNNA

LNN7      ke  7 0
LNN7A     ke  100 0
.         ti  LNN7A LNN7
.         so  LNNA

# ia += 本数。本数は 7 以下なので桁上げは一段で足りる
LNNA      ke  100 0
LNNB      ta  LNNA
LNNC      ke  24 0
LNND      ta  LNNC
LNNE      ko  LNND LNNB
LNNF      ke  256 0
.         se  LNNE LNNF LNNX
LNNG      si  LNNF
LNNH      ko  LNNE LNNG
LNNI      ke  24 0
.         ti  LNNI LNNH
LNNJ      ke  25 0
LNNK      ta  LNNJ
LNNL      ke  1 0
LNNM      ko  LNNK LNNL
LNNN      ke  256 0
.         se  LNNM LNNN LNNY
LNNO      si  LNNN
LNNP      ko  LNNM LNNO
LNNQ      ke  25 0
.         ti  LNNQ LNNP
LNNR      ke  26 0
LNNS      ta  LNNR
LNNT      ke  1 0
LNNU      ko  LNNS LNNT
.         ti  LNNR LNNU
.         so  LNNZ

LNNY      ke  25 0
.         ti  LNNY LNNM
.         so  LNNZ

LNNX      ke  24 0
.         ti  LNNX LNNE
.         so  LNNZ

LNNZ      ke  20 0
LNNa      ta  LNNZ
LNNb      ke  1 0
LNNc      ko  LNNa LNNb
.         ti  LNNZ LNNc

# ---- 閉じ ----
LNNd      ke  20 0
LNNe      ta  LNNd
LNNf      ke  6 0
LNNg      ta  LNNf
.         se  LNNe LNNg LNW5
.         so  LNR0

# ================= 第 5 段：Emit =================

LNR0      ke  15 0
LNRZ      ke  0 0
.         ti  LNR0 LNRZ
LNR1      ke  20 0
.         ti  LNR1 LNRZ

# ---- 入口 ----
LNR2      ke  20 0
LNR3      ta  LNR2
LNR4      ke  6 0
LNR5      ta  LNR4
.         se  LNR3 LNR5 LNW6
.         so  LN6

# ---- 箱ひとつ ----
LNW6      ke  103 0
LNW6Z     ke  0 0
.         ti  LNW6 LNW6Z

# 雛形を零で埋める。112 語
LNZ1      ke  103 0
LNZ2      ta  LNZ1
LNZ3      ke  112 0
.         se  LNZ2 LNZ3 LNZL
.         so  LNZE

LNZL      ke  103 0
LNZ4      ta  LNZL
LNZ5      ke  200 0
LNZ6      ko  LNZ5 LNZ4
LNZ7      ke  0 0
.         ti  LNZ6 LNZ7
LNZ8      ke  1 0
LNZ9      ko  LNZ4 LNZ8
.         ti  LNZL LNZ9
LNZA      ke  103 0
LNZB      ta  LNZA
LNZC      ke  112 0
.         se  LNZB LNZC LNZL
.         so  LNZE

# ---- 出力語 64+j の byte を語 116..118 へ ----
LNZE      ke  20 0
LNZF      ta  LNZE
LNZG      sa  KV14 BW
LNZH      ko  LNZG LNZF
LNZI      ta  LNZH
LNZJ      ke  116 0
.         ti  LNZJ LNZI
LNZK      sa  KV16 BW
LNZL2     ko  LNZK LNZF
LNZM      ta  LNZL2
LNZN      ke  117 0
.         ti  LNZN LNZM
LNZO      sa  KV18 BW
LNZP      ko  LNZO LNZF
LNZQ      ta  LNZP
LNZR      ke  118 0
.         ti  LNZR LNZQ

# ---- 種類で分ける ----
LNZS      sa  KV04 BW
LNZT      ko  LNZS LNZF
LNZU      ta  LNZT
LNZV      ke  6 0
.         su  LNZU LNZV LNFOK
LNZV2     ke  10 0
.         su  LNZU LNZV2 LNFKO
LNZW      ke  1 0
.         su  LNZU LNZW LNFCS

# ---- u と v を読む。Neg は第二入力を第一と同じにする ----
LNZX      sa  KV06 BW
LNZY      ko  LNZX LNZF
LNZa      ta  LNZY
LNZb      ke  104 0
.         ti  LNZb LNZa
LNZc      sa  KV08 BW
LNZd      ko  LNZc LNZF
LNZe      ta  LNZd
LNZf      ke  105 0
.         ti  LNZf LNZe
LNZg      ke  4 0
.         su  LNZU LNZg LNNEG
.         so  LNUV

LNNEG     ke  105 0
LNNEGa    ke  104 0
LNNEGb    ta  LNNEGa
.         ti  LNNEG LNNEGb

# ---- 64+u と 64+v の byte を語 110..115 へ ----
LNUV      ke  104 0
LNUVa     ta  LNUV
LNUVb     sa  KV14 BW
LNUVc     ko  LNUVb LNUVa
LNUVd     ta  LNUVc
LNUVe     ke  110 0
.         ti  LNUVe LNUVd
LNUVf     sa  KV16 BW
LNUVg     ko  LNUVf LNUVa
LNUVh     ta  LNUVg
LNUVi     ke  111 0
.         ti  LNUVi LNUVh
LNUVj     sa  KV18 BW
LNUVk     ko  LNUVj LNUVa
LNUVl     ta  LNUVk
LNUVm     ke  112 0
.         ti  LNUVm LNUVl

LNUVn     ke  105 0
LNUVo     ta  LNUVn
LNUVp     sa  KV14 BW
LNUVq     ko  LNUVp LNUVo
LNUVr     ta  LNUVq
LNUVs     ke  113 0
.         ti  LNUVs LNUVr
LNUVt     sa  KV16 BW
LNUVu     ko  LNUVt LNUVo
LNUVv     ta  LNUVu
LNUVw     ke  114 0
.         ti  LNUVw LNUVv
LNUVx     sa  KV18 BW
LNUVy     ko  LNUVx LNUVo
LNUVz     ta  LNUVy
LNUVA     ke  115 0
.         ti  LNUVA LNUVz

# ---- 命令 0：MAT 3, 64+u ----
LNI0      ke  200 0
LNI0a     ke  1 0
.         ti  LNI0 LNI0a
LNI0b     ke  201 0
LNI0c     ke  3 0
.         ti  LNI0b LNI0c
LNI0d     ke  208 0
LNI0e     ke  110 0
LNI0f     ta  LNI0e
.         ti  LNI0d LNI0f
LNI0g     ke  209 0
LNI0h     ke  111 0
LNI0i     ta  LNI0h
.         ti  LNI0g LNI0i
LNI0j     ke  210 0
LNI0k     ke  112 0
LNI0l     ta  LNI0k
.         ti  LNI0j LNI0l

# ---- 命令 1：LD 1, 3 ----
LNI1      ke  216 0
LNI1a     ke  8 0
.         ti  LNI1 LNI1a
LNI1b     ke  217 0
LNI1c     ke  1 0
.         ti  LNI1b LNI1c
LNI1d     ke  218 0
LNI1e     ke  3 0
.         ti  LNI1d LNI1e

# Load と Put は第二入力を持たない
LNI1f     ke  7 0
.         su  LNZU LNI1f LNFLD
LNI1g     ke  11 0
.         su  LNZU LNI1g LNFPU

# ---- 命令 2：MAT 3, 64+v ----
LNI2      ke  232 0
LNI2a     ke  1 0
.         ti  LNI2 LNI2a
LNI2b     ke  233 0
LNI2c     ke  3 0
.         ti  LNI2b LNI2c
LNI2d     ke  240 0
